@page "/portal"
@layout PortalLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

<AuthorizeView>
    <Authorized>
        <MudProgressCircular Indeterminate="true" />
    </Authorized>
    <NotAuthorized>
        <MudPaper Class="pa-6">
            <MudText Typo="Typo.h5" Class="mb-4">HAMS Guardian / Student Portal</MudText>
            <MudStack Row="true" Spacing="4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/guardian/login">Guardian Sign In</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Href="/student/login">Student Sign In</MudButton>
            </MudStack>
        </MudPaper>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Inject] private PortalAuthenticationStateProvider AuthStateProvider { get; set; } = null!;
    [Inject] private NavigationManager Nav { get; set; } = null!;

    // Redirects rather than rendering feature content directly here — MyChildren/StudentHome own
    // their own data loads, this page is just the signed-out landing/chooser plus a dispatch point.
    protected override async Task OnInitializedAsync()
    {
        if (await AuthStateProvider.HasClaimAsync(HamsClaimTypes.IsGuardian, "true"))
        {
            Nav.NavigateTo("/portal/children", forceLoad: false);
        }
        else if (await AuthStateProvider.HasClaimAsync(HamsClaimTypes.IsStudent, "true"))
        {
            Nav.NavigateTo("/portal/student", forceLoad: false);
        }
    }
}
