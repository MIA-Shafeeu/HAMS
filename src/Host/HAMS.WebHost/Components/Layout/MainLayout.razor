@inherits LayoutComponentBase
@* No @rendermode here — a layout receives Body as a RenderFragment from the static Router, and a
   RenderFragment can't cross a static->interactive boundary. Every routable page that uses this
   layout must declare its own "@rendermode InteractiveServer"; Blazor then resolves the whole
   page+layout tree under that same interactive render mode. *@

<MudThemeProvider Theme="HamsTheme.Default" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<AuthorizeView>
    <Authorized>
        <MudLayout>
            <MudAppBar Elevation="1">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
                <MudText Typo="Typo.h6" Class="ml-2">HAMS</MudText>
                <MudText Typo="Typo.body2" Class="ml-2 hams-appbar-subtitle">Hirilandhoo Academic Management System</MudText>
                <MudSpacer />
                <form method="post" action="/account/logout">
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Logout">
                        Sign out
                    </MudButton>
                </form>
            </MudAppBar>
            <MudDrawer @bind-Open="_drawerOpen" Elevation="1" ClipMode="DrawerClipMode.Always" Variant="DrawerVariant.Responsive">
                <NavMenu />
            </MudDrawer>
            <MudMainContent>
                <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-6 px-4">
                    @* Many pages have a click handler or dropdown-cascade callback that doesn't
                       catch its own service exceptions. Without this boundary, one unhandled
                       exception anywhere in @Body tears down the whole SignalR circuit - the page
                       and everything else in the app goes blank until a full browser reload. The
                       boundary confines that to the one page, with a way to retry without losing
                       the tab/session. *@
                    <ErrorBoundary @ref="_errorBoundary">
                        <ChildContent>
                            @Body
                        </ChildContent>
                        <ErrorContent Context="_">
                            <MudAlert Severity="Severity.Error" Class="my-4">
                                Something went wrong loading or updating this page.
                                <MudButton Variant="Variant.Text" Color="Color.Inherit" Class="ml-2" OnClick="@(() => _errorBoundary?.Recover())">Try again</MudButton>
                            </MudAlert>
                        </ErrorContent>
                    </ErrorBoundary>
                </MudContainer>
            </MudMainContent>
        </MudLayout>
    </Authorized>
    <NotAuthorized>
        @Body
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private ErrorBoundary? _errorBoundary;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
