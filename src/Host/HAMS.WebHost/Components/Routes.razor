@using HAMS.WebHost.Components.Account

@* NotFoundPage used to reference the (now-migrated-to-Razor-Pages) Pages.NotFound component by
   type. Blazor's own 404 handling is unused now - app.UseStatusCodePagesWithReExecute("/not-found",
   ...) in Program.cs re-executes any 404 (from this router or from a Razor Page) to the new
   Pages/NotFound.cshtml uniformly, so no NotFoundPage parameter is needed here at all. *@
<Router AppAssembly="typeof(Program).Assembly" AdditionalAssemblies="new[] { typeof(Client._Imports).Assembly }">
    <Found Context="routeData">
        @* MainLayout (the staff/admin Blazor Server shell) was deleted once every staff/admin page
           had migrated to Razor Pages - every remaining routable component is a guardian/student
           portal page, and all of them declare their own @layout PortalLayout explicitly, so this
           fallback is never actually hit in practice. Points at PortalLayout rather than leaving a
           dangling reference to the deleted MainLayout. *@
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Client.Layout.PortalLayout)">
            <NotAuthorized Context="authState">
                @* Authenticated-but-forbidden must NOT redirect to login — that's just an
                   authenticated user hitting the login page again, which sends them straight back
                   here (an infinite loop). Only a genuinely anonymous visitor gets sent to sign in. *@
                @if (authState.User.Identity?.IsAuthenticated == true)
                {
                    <div class="account-page">
                        <div class="account-card">
                            <div class="account-brand">
                                <span class="account-brand-mark">HAMS</span>
                                <span class="account-brand-sub">Hirilandhoo Academic Management System</span>
                            </div>
                            <h1 class="account-title">Access denied</h1>
                            <p class="account-subtitle">Your account doesn't have permission to view this page.</p>
                            <a class="account-link" href="/">Back to home</a>
                        </div>
                    </div>
                }
                else
                {
                    <RedirectToLogin />
                }
            </NotAuthorized>
            <Authorizing>
                <div class="account-page"><p>Checking access…</p></div>
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
