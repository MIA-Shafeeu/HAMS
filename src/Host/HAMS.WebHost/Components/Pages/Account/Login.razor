@page "/account/login"
@layout HAMS.WebHost.Components.Layout.AccountLayout
@using System.ComponentModel.DataAnnotations
@using HAMS.IdentityAccess.Application.Auth
@using HAMS.WebHost.Components.Account
@inject IStaffAuthenticationService StaffAuth
@inject NavigationManager Navigation

<PageTitle>Sign in — HAMS</PageTitle>

<div class="account-card">
    <div class="account-brand">
        <span class="account-brand-mark">HAMS</span>
        <span class="account-brand-sub">Hirilandhoo Academic Management System</span>
    </div>

    <h1 class="account-title">Staff sign in</h1>

    @if (_error is not null)
    {
        <div class="account-alert" role="alert">@_error</div>
    }

    <EditForm Model="Credentials!" FormName="staff-login" OnValidSubmit="HandleSubmitAsync">
        <DataAnnotationsValidator />

        <div class="account-field">
            <label for="usernameOrEmail">Username or email</label>
            <InputText id="usernameOrEmail" @bind-Value="Credentials!.UsernameOrEmail" autofocus="true" />
            <ValidationMessage For="() => Credentials!.UsernameOrEmail" />
        </div>

        <div class="account-field">
            <label for="password">Password</label>
            <InputText id="password" type="password" @bind-Value="Credentials!.Password" />
            <ValidationMessage For="() => Credentials!.Password" />
        </div>

        <button type="submit" class="account-submit">Sign in</button>
    </EditForm>
</div>

@code {
    [SupplyParameterFromForm(FormName = "staff-login")]
    private CredentialsModel? Credentials { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string? _error;

    protected override void OnInitialized()
    {
        Credentials ??= new();

        if (HttpContext.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo(SafeReturnUrl(), forceLoad: true);
        }
    }

    private async Task HandleSubmitAsync()
    {
        var result = await StaffAuth.LoginAsync(
            new StaffLoginRequest(Credentials!.UsernameOrEmail, Credentials!.Password, "HAMS Web (Blazor)"),
            HttpContext.Connection.RemoteIpAddress?.ToString());

        if (result.MfaRequired && result.MfaToken is not null)
        {
            var mfaUrl = $"/account/login/mfa?token={Uri.EscapeDataString(result.MfaToken)}&returnUrl={Uri.EscapeDataString(SafeReturnUrl())}";
            Navigation.NavigateTo(mfaUrl, forceLoad: true);
            return;
        }

        if (!result.Succeeded)
        {
            _error = result.Error ?? "Invalid username or password.";
            return;
        }

        await StaffCookieSignIn.SignInAsync(HttpContext, result);
        Navigation.NavigateTo(SafeReturnUrl(), forceLoad: true);
    }

    private string SafeReturnUrl()
        => !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//")
            ? ReturnUrl
            : "/dashboard";

    private sealed class CredentialsModel
    {
        [Required(ErrorMessage = "Enter your username or email.")]
        public string UsernameOrEmail { get; set; } = "";

        [Required(ErrorMessage = "Enter your password.")]
        public string Password { get; set; } = "";
    }
}
