@page "/admin/curriculum-setup"
@using HAMS.WebHost.Components.Account
@attribute [Authorize(Policy = SystemOrSchoolAdminPolicy.Name)]
@rendermode InteractiveServer
@using HAMS.OrgCurriculum.Application
@using HAMS.Platform.Common.Contracts
@using Microsoft.AspNetCore.Components.Forms
@using CurrFramework = HAMS.OrgCurriculum.Domain.CurriculumFramework
@using CurrLearningArea = HAMS.OrgCurriculum.Domain.LearningArea
@using CurrSubject = HAMS.OrgCurriculum.Domain.Subject
@using CurrSyllabus = HAMS.OrgCurriculum.Domain.Syllabus
@using CurrDeliveryMode = HAMS.OrgCurriculum.Domain.DeliveryMode
@using CurrMedium = HAMS.OrgCurriculum.Domain.MediumOfInstruction
@using CurrGrade = HAMS.OrgCurriculum.Domain.Grade
@using CurrSchool = HAMS.OrgCurriculum.Domain.School
@inject IOrgAdminService OrgAdmin
@inject ICurriculumAdminService CurriculumAdmin
@inject ISyllabusPublishingService SyllabusPublishing
@inject ICurriculumCsvImportService CsvImport
@inject ISnackbar Snackbar

<PageTitle>Curriculum Setup — HAMS</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">System Administration — Curriculum Setup</MudText>

<MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true">

    <MudTabPanel Text="Curriculum Frameworks">
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="3"><MudTextField T="string" @bind-Value="_newFrameworkCode" Label="Code" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField T="string" @bind-Value="_newFrameworkName" Label="Name" /></MudItem>
            <MudItem xs="12" sm="3"><MudTextField T="string" @bind-Value="_newFrameworkDescription" Label="Description" /></MudItem>
            <MudItem xs="12" sm="2" Class="d-flex align-end"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateFrameworkAsync">Create</MudButton></MudItem>
        </MudGrid>
        <MudTable Items="@_frameworks" Dense="true" Hover="true">
            <HeaderContent><MudTh>Code</MudTh><MudTh>Name</MudTh><MudTh>Description</MudTh></HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Code">@context.Code</MudTd>
                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd DataLabel="Description">@context.Description</MudTd>
            </RowTemplate>
        </MudTable>
    </MudTabPanel>

    <MudTabPanel Text="Learning Areas">
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="3">
                <MudSelect T="Guid" @bind-Value="_newLearningAreaFrameworkId" Label="Framework" Dense="true">
                    @foreach (var framework in _frameworks) { <MudSelectItem T="Guid" Value="@framework.Id">@framework.Name</MudSelectItem> }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="3"><MudTextField T="string" @bind-Value="_newLearningAreaCode" Label="Code" /></MudItem>
            <MudItem xs="12" sm="3"><MudTextField T="string" @bind-Value="_newLearningAreaName" Label="Name" /></MudItem>
            <MudItem xs="12" sm="1"><MudNumericField T="int" @bind-Value="_newLearningAreaDisplayOrder" Label="Order" /></MudItem>
            <MudItem xs="12" sm="2" Class="d-flex align-end"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateLearningAreaAsync">Create</MudButton></MudItem>
        </MudGrid>
        <MudTable Items="@_learningAreas" Dense="true" Hover="true">
            <HeaderContent><MudTh>Order</MudTh><MudTh>Code</MudTh><MudTh>Name</MudTh></HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Order">@context.DisplayOrder</MudTd>
                <MudTd DataLabel="Code">@context.Code</MudTd>
                <MudTd DataLabel="Name">@context.Name</MudTd>
            </RowTemplate>
        </MudTable>
    </MudTabPanel>

    <MudTabPanel Text="Subjects">
        <MudSelect T="Guid" Value="_selectedSchoolId" ValueChanged="OnSchoolChangedForSubjectsAsync" Label="School" Dense="true" Class="mb-4">
            @foreach (var school in _schools) { <MudSelectItem T="Guid" Value="@school.Id">@school.Name</MudSelectItem> }
        </MudSelect>

        @if (_selectedSchoolId != Guid.Empty)
        {
            <MudGrid Class="mb-4">
                <MudItem xs="12" sm="2">
                    <MudSelect T="Guid" @bind-Value="_newSubjectLearningAreaId" Label="Learning Area" Dense="true">
                        @foreach (var area in _learningAreas) { <MudSelectItem T="Guid" Value="@area.Id">@area.Name</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="2"><MudTextField T="string" @bind-Value="_newSubjectCode" Label="Code" /></MudItem>
                <MudItem xs="12" sm="3"><MudTextField T="string" @bind-Value="_newSubjectName" Label="Name" /></MudItem>
                <MudItem xs="12" sm="2">
                    <MudSelect T="Guid" @bind-Value="_newSubjectDeliveryModeId" Label="Delivery Mode" Dense="true">
                        @foreach (var mode in _deliveryModes) { <MudSelectItem T="Guid" Value="@mode.Id">@mode.Name</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="2">
                    <MudSelect T="Guid" @bind-Value="_newSubjectMediumId" Label="Medium" Dense="true">
                        @foreach (var medium in _mediums) { <MudSelectItem T="Guid" Value="@medium.Id">@medium.Name</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="1" Class="d-flex align-end"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateSubjectAsync">Create</MudButton></MudItem>
            </MudGrid>
            <MudTable Items="@_subjects" Dense="true" Hover="true">
                <HeaderContent><MudTh>Order</MudTh><MudTh>Code</MudTh><MudTh>Name</MudTh><MudTh></MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Order">@context.DisplayOrder</MudTd>
                    <MudTd DataLabel="Code">@context.Code</MudTd>
                    <MudTd DataLabel="Name">@context.Name</MudTd>
                    <MudTd><MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => SelectSubjectForSyllabusAsync(context.Id))">Manage Syllabus</MudButton></MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudTabPanel>

    <MudTabPanel Text="Syllabus">
        <MudAlert Severity="Severity.Info" Class="mb-4">
            This is a thin wrapper over the existing syllabus publishing service — clone-on-publish versioning, not a curriculum-authoring tool.
            Pick a subject from the Subjects tab ("Manage Syllabus"), or a school + subject below.
        </MudAlert>

        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="4">
                <MudSelect T="Guid" Value="_selectedSchoolId" ValueChanged="OnSchoolChangedForSubjectsAsync" Label="School" Dense="true">
                    @foreach (var school in _schools) { <MudSelectItem T="Guid" Value="@school.Id">@school.Name</MudSelectItem> }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="Guid" Value="_selectedSubjectId" ValueChanged="SelectSubjectForSyllabusAsync" Label="Subject" Dense="true">
                    @foreach (var subject in _subjects) { <MudSelectItem T="Guid" Value="@subject.Id">@subject.Name</MudSelectItem> }
                </MudSelect>
            </MudItem>
        </MudGrid>

        @if (_selectedSubjectId != Guid.Empty)
        {
            <MudTable Items="@_syllabuses" Dense="true" Hover="true" Class="mb-4">
                <HeaderContent><MudTh>Version</MudTh><MudTh>Status</MudTh><MudTh>Current</MudTh><MudTh></MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Version">@context.Version</MudTd>
                    <MudTd DataLabel="Status">@context.Status</MudTd>
                    <MudTd DataLabel="Current">@(context.IsCurrent ? "Yes" : "")</MudTd>
                    <MudTd>
                        <MudStack Row="true" Spacing="1">
                            @if (context.Status == RecordStatus.Draft)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success" OnClick="@(() => PublishSyllabusAsync(context.Id))">Publish</MudButton>
                            }
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => SelectSyllabusForDetailAsync(context.Id))">Manage</MudButton>
                        </MudStack>
                    </MudTd>
                </RowTemplate>
            </MudTable>

            @if (_syllabuses.Count == 0)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateInitialDraftAsync" Class="mb-4">Create Initial Draft Syllabus</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="@(() => CreateDraftRevisionAsync(_syllabuses.OrderByDescending(s => s.Version).First().Id))" Class="mb-4">
                    Create Draft Revision (from latest)
                </MudButton>
            }

            @if (_selectedSyllabusId != Guid.Empty)
            {
                <MudDivider Class="my-4" />
                <MudText Typo="Typo.h6" Class="mb-2">Grade Applicability — Version @_syllabuses.SingleOrDefault(s => s.Id == _selectedSyllabusId)?.Version</MudText>
                <MudGrid Class="mb-4">
                    <MudItem xs="12" sm="4">
                        <MudSelect T="Guid" @bind-Value="_newApplicabilityGradeId" Label="Grade" Dense="true">
                            @foreach (var grade in _grades) { <MudSelectItem T="Guid" Value="@grade.Id">@grade.Name</MudSelectItem> }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="2" Class="d-flex align-end"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddGradeApplicabilityAsync">Add</MudButton></MudItem>
                </MudGrid>
                <MudStack Row="true" Spacing="1" Class="mb-4">
                    @foreach (var gradeId in _syllabusGradeApplicabilities.Select(a => a.GradeId))
                    {
                        <MudChip T="string">@(_grades.SingleOrDefault(g => g.Id == gradeId)?.Name ?? gradeId.ToString())</MudChip>
                    }
                </MudStack>

                <MudText Typo="Typo.h6" Class="mb-2">CSV Import (Strand/SubStrand/Outcome/Indicator)</MudText>
                <MudText Typo="Typo.body2" Class="mb-2">
                    Header: StrandCode,StrandName,SubStrandCode,SubStrandName,OutcomeCode,OutcomeDescription,IndicatorCode,IndicatorDescription. Only valid for a Draft syllabus.
                </MudText>
                <InputFile OnChange="ImportCsvAsync" accept=".csv" />
            }
        }
    </MudTabPanel>

</MudTabs>

@code {
    private IReadOnlyList<CurrFramework> _frameworks = [];
    private IReadOnlyList<CurrLearningArea> _learningAreas = [];
    private IReadOnlyList<CurrDeliveryMode> _deliveryModes = [];
    private IReadOnlyList<CurrMedium> _mediums = [];
    private IReadOnlyList<CurrSchool> _schools = [];
    private IReadOnlyList<CurrSubject> _subjects = [];
    private IReadOnlyList<CurrSyllabus> _syllabuses = [];
    private IReadOnlyList<HAMS.OrgCurriculum.Domain.SyllabusGradeApplicability> _syllabusGradeApplicabilities = [];
    private IReadOnlyList<CurrGrade> _grades = [];

    private Guid _selectedSchoolId;
    private Guid _selectedSubjectId;
    private Guid _selectedSyllabusId;

    private string _newFrameworkCode = "";
    private string _newFrameworkName = "";
    private string _newFrameworkDescription = "";

    private Guid _newLearningAreaFrameworkId;
    private string _newLearningAreaCode = "";
    private string _newLearningAreaName = "";
    private int _newLearningAreaDisplayOrder;

    private Guid _newSubjectLearningAreaId;
    private string _newSubjectCode = "";
    private string _newSubjectName = "";
    private Guid _newSubjectDeliveryModeId;
    private Guid _newSubjectMediumId;

    private Guid _newApplicabilityGradeId;

    protected override async Task OnInitializedAsync()
    {
        _frameworks = await CurriculumAdmin.GetCurriculumFrameworksAsync();
        _learningAreas = await CurriculumAdmin.GetLearningAreasAsync();
        _deliveryModes = await CurriculumAdmin.GetDeliveryModesAsync();
        _mediums = await CurriculumAdmin.GetMediumsOfInstructionAsync();
        _schools = await OrgAdmin.GetSchoolsAsync();
    }

    private async Task CreateFrameworkAsync()
    {
        await CurriculumAdmin.CreateCurriculumFrameworkAsync(_newFrameworkCode, _newFrameworkName, string.IsNullOrWhiteSpace(_newFrameworkDescription) ? null : _newFrameworkDescription);
        _newFrameworkCode = ""; _newFrameworkName = ""; _newFrameworkDescription = "";
        _frameworks = await CurriculumAdmin.GetCurriculumFrameworksAsync();
        Snackbar.Add("Curriculum framework created.", Severity.Success);
    }

    private async Task CreateLearningAreaAsync()
    {
        if (_newLearningAreaFrameworkId == Guid.Empty) { Snackbar.Add("Select a framework first.", Severity.Warning); return; }
        await CurriculumAdmin.CreateLearningAreaAsync(_newLearningAreaFrameworkId, _newLearningAreaCode, _newLearningAreaName, _newLearningAreaDisplayOrder);
        _newLearningAreaCode = ""; _newLearningAreaName = ""; _newLearningAreaDisplayOrder = 0;
        _learningAreas = await CurriculumAdmin.GetLearningAreasAsync();
        Snackbar.Add("Learning area created.", Severity.Success);
    }

    private async Task OnSchoolChangedForSubjectsAsync(Guid schoolId)
    {
        _selectedSchoolId = schoolId;
        _selectedSubjectId = Guid.Empty;
        _selectedSyllabusId = Guid.Empty;
        _subjects = await CurriculumAdmin.GetSubjectsAsync(schoolId);
        _grades = await OrgAdmin.GetGradesAsync(schoolId);
    }

    private async Task CreateSubjectAsync()
    {
        if (_selectedSchoolId == Guid.Empty || _newSubjectLearningAreaId == Guid.Empty || _newSubjectDeliveryModeId == Guid.Empty || _newSubjectMediumId == Guid.Empty)
        {
            Snackbar.Add("Select a school, learning area, delivery mode and medium first.", Severity.Warning);
            return;
        }

        var deliveryModeCode = _deliveryModes.Single(m => m.Id == _newSubjectDeliveryModeId).Code;
        var mediumCode = _mediums.Single(m => m.Id == _newSubjectMediumId).Code;

        try
        {
            await CurriculumAdmin.CreateSubjectAsync(_selectedSchoolId, _newSubjectLearningAreaId, _newSubjectCode, _newSubjectName, deliveryModeCode, mediumCode, 0);
            _newSubjectCode = ""; _newSubjectName = "";
            _subjects = await CurriculumAdmin.GetSubjectsAsync(_selectedSchoolId);
            Snackbar.Add("Subject created.", Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task SelectSubjectForSyllabusAsync(Guid subjectId)
    {
        _selectedSubjectId = subjectId;
        _selectedSyllabusId = Guid.Empty;
        _syllabuses = await CurriculumAdmin.GetSyllabusesForSubjectAsync(subjectId);
        _syllabusGradeApplicabilities = [];
    }

    private async Task SelectSyllabusForDetailAsync(Guid syllabusId)
    {
        _selectedSyllabusId = syllabusId;
        _syllabusGradeApplicabilities = await CurriculumAdmin.GetSyllabusGradeApplicabilitiesAsync(syllabusId);
    }

    private async Task CreateInitialDraftAsync()
    {
        var id = await SyllabusPublishing.CreateInitialDraftAsync(_selectedSubjectId);
        _syllabuses = await CurriculumAdmin.GetSyllabusesForSubjectAsync(_selectedSubjectId);
        await SelectSyllabusForDetailAsync(id);
        Snackbar.Add("Initial draft syllabus created.", Severity.Success);
    }

    private async Task CreateDraftRevisionAsync(Guid existingSyllabusId)
    {
        var id = await SyllabusPublishing.CreateDraftRevisionAsync(existingSyllabusId);
        _syllabuses = await CurriculumAdmin.GetSyllabusesForSubjectAsync(_selectedSubjectId);
        await SelectSyllabusForDetailAsync(id);
        Snackbar.Add("Draft revision created.", Severity.Success);
    }

    private async Task PublishSyllabusAsync(Guid syllabusId)
    {
        try
        {
            await SyllabusPublishing.PublishAsync(syllabusId);
            _syllabuses = await CurriculumAdmin.GetSyllabusesForSubjectAsync(_selectedSubjectId);
            Snackbar.Add("Syllabus published.", Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task AddGradeApplicabilityAsync()
    {
        if (_selectedSyllabusId == Guid.Empty || _newApplicabilityGradeId == Guid.Empty)
        {
            Snackbar.Add("Select a syllabus and a grade first.", Severity.Warning);
            return;
        }

        await CurriculumAdmin.AddSyllabusGradeApplicabilityAsync(_selectedSyllabusId, _newApplicabilityGradeId);
        _syllabusGradeApplicabilities = await CurriculumAdmin.GetSyllabusGradeApplicabilitiesAsync(_selectedSyllabusId);
        Snackbar.Add("Grade applicability added.", Severity.Success);
    }

    private async Task ImportCsvAsync(InputFileChangeEventArgs e)
    {
        if (_selectedSyllabusId == Guid.Empty) { Snackbar.Add("Select a syllabus first.", Severity.Warning); return; }

        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            var result = await CsvImport.ImportAsync(_selectedSyllabusId, stream);
            Snackbar.Add($"Imported {result.StrandsCreated} strands, {result.SubStrandsCreated} sub-strands, {result.OutcomesCreated} outcomes, {result.IndicatorsCreated} indicators.", Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
