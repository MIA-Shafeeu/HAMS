@page "/admin/reference-data"
@using HAMS.WebHost.Components.Account
@attribute [Authorize(Policy = SystemOrSchoolAdminPolicy.Name)]
@rendermode InteractiveServer
@using HAMS.OrgCurriculum.Application
@using HAMS.PeopleEnrollment.Application
@using HAMS.Attendance.Application
@using HAMS.Intervention.Application
@using HAMS.AssessmentEvaluation.Application
@using HAMS.LearningDelivery.Application
@using HAMS.Platform.Access
@using HAMS.WebHost.Components.Pages.Admin.Shared
@using AccessRole = HAMS.Platform.Access.Domain.Role
@using AccessConfidentialityTier = HAMS.Platform.Access.Domain.ConfidentialityTier
@using OrgEvaluationModel = HAMS.OrgCurriculum.Domain.EvaluationModel
@using OrgDeliveryMode = HAMS.OrgCurriculum.Domain.DeliveryMode
@using OrgMediumOfInstruction = HAMS.OrgCurriculum.Domain.MediumOfInstruction
@using OrgHolidayType = HAMS.OrgCurriculum.Domain.HolidayType
@using PplRelationshipType = HAMS.PeopleEnrollment.Domain.RelationshipType
@using PplRestrictionType = HAMS.PeopleEnrollment.Domain.RestrictionType
@using PplEmploymentStatus = HAMS.PeopleEnrollment.Domain.EmploymentStatus
@using PplEnrollmentType = HAMS.PeopleEnrollment.Domain.EnrollmentType
@using AttAttendanceStatus = HAMS.Attendance.Domain.AttendanceStatus
@using IntBehaviourCategory = HAMS.Intervention.Domain.BehaviourCategory
@using IntInterventionType = HAMS.Intervention.Domain.InterventionType
@using AsmAssessmentCategory = HAMS.AssessmentEvaluation.Domain.AssessmentCategory
@using AsmExternalExaminationBoard = HAMS.AssessmentEvaluation.Domain.ExternalExaminationBoard
@using AsmSpecialResultState = HAMS.AssessmentEvaluation.Domain.SpecialResultState
@using AsmResultAggregationRule = HAMS.AssessmentEvaluation.Domain.ResultAggregationRule
@using LrnResourceType = HAMS.LearningDelivery.Domain.ResourceType
@using LrnEvidenceType = HAMS.LearningDelivery.Domain.EvidenceType
@inject IPersonRoleAssignmentService RoleAssignments
@inject IOrgAdminService OrgAdmin
@inject ICurriculumAdminService CurriculumAdmin
@inject IPeopleAdminService PeopleAdmin
@inject IAttendanceAdminService AttendanceAdmin
@inject IInterventionAdminService InterventionAdmin
@inject IAssessmentConfigAdminService AssessmentConfig
@inject ILessonPlanningService LessonPlanning
@inject ISnackbar Snackbar

<PageTitle>Reference Data — HAMS</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">System Administration — Reference Data</MudText>
<MudAlert Severity="Severity.Info" Class="mb-4">
    Every configurable lookup in the system (build plan §1.6: names/categories/scales are admin-editable data, never a hardcoded value). Deactivating a row keeps its history intact — it just stops appearing as a selectable option elsewhere.
</MudAlert>

<MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true">

    <MudTabPanel Text="Roles &amp; Confidentiality">
        <MudText Typo="Typo.h6" Class="mb-2">Roles</MudText>
        <SimpleLookupManager TLookup="AccessRole" Items="_roles" OnCreate="CreateRoleAsync" OnSetActive="SetRoleActiveAsync" />

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.h6" Class="mb-2">Confidentiality Tiers</MudText>
        <SimpleLookupManager TLookup="AccessConfidentialityTier" Items="_confidentialityTiers" OnCreate="CreateConfidentialityTierAsync" OnSetActive="SetConfidentialityTierActiveAsync">
            <ExtraFields>
                <MudItem xs="12" sm="2"><MudNumericField T="int" @bind-Value="_newTierRank" Label="Rank" /></MudItem>
            </ExtraFields>
            <HeaderExtra><MudTh>Rank</MudTh></HeaderExtra>
            <RowExtra Context="tier"><MudTd DataLabel="Rank">@tier.Rank</MudTd></RowExtra>
        </SimpleLookupManager>
    </MudTabPanel>

    <MudTabPanel Text="Curriculum">
        <MudText Typo="Typo.h6" Class="mb-2">Evaluation Models</MudText>
        <SimpleLookupManager TLookup="OrgEvaluationModel" Items="_evaluationModels" OnCreate="CreateEvaluationModelAsync" OnSetActive="SetEvaluationModelActiveAsync" />

        <MudDivider Class="my-4" />
        <MudText Typo="Typo.h6" Class="mb-2">Delivery Modes</MudText>
        <SimpleLookupManager TLookup="OrgDeliveryMode" Items="_deliveryModes" OnCreate="CreateDeliveryModeAsync" OnSetActive="SetDeliveryModeActiveAsync" />

        <MudDivider Class="my-4" />
        <MudText Typo="Typo.h6" Class="mb-2">Mediums of Instruction</MudText>
        <SimpleLookupManager TLookup="OrgMediumOfInstruction" Items="_mediumsOfInstruction" OnCreate="CreateMediumOfInstructionAsync" OnSetActive="SetMediumOfInstructionActiveAsync" />

        <MudDivider Class="my-4" />
        <MudText Typo="Typo.h6" Class="mb-2">Holiday Types</MudText>
        <SimpleLookupManager TLookup="OrgHolidayType" Items="_holidayTypes" OnCreate="CreateHolidayTypeAsync" OnSetActive="SetHolidayTypeActiveAsync" />
    </MudTabPanel>

    <MudTabPanel Text="People">
        <MudText Typo="Typo.h6" Class="mb-2">Guardian Relationship Types</MudText>
        <SimpleLookupManager TLookup="PplRelationshipType" Items="_relationshipTypes" OnCreate="CreateRelationshipTypeAsync" OnSetActive="SetRelationshipTypeActiveAsync" />

        <MudDivider Class="my-4" />
        <MudText Typo="Typo.h6" Class="mb-2">Restriction Types</MudText>
        <SimpleLookupManager TLookup="PplRestrictionType" Items="_restrictionTypes" OnCreate="CreateRestrictionTypeAsync" OnSetActive="SetRestrictionTypeActiveAsync" />

        <MudDivider Class="my-4" />
        <MudText Typo="Typo.h6" Class="mb-2">Employment Statuses</MudText>
        <SimpleLookupManager TLookup="PplEmploymentStatus" Items="_employmentStatuses" OnCreate="CreateEmploymentStatusAsync" OnSetActive="SetEmploymentStatusActiveAsync" />

        <MudDivider Class="my-4" />
        <MudText Typo="Typo.h6" Class="mb-2">Enrollment Types</MudText>
        <SimpleLookupManager TLookup="PplEnrollmentType" Items="_enrollmentTypes" OnCreate="CreateEnrollmentTypeAsync" OnSetActive="SetEnrollmentTypeActiveAsync" />
    </MudTabPanel>

    <MudTabPanel Text="Attendance &amp; Behaviour">
        <MudText Typo="Typo.h6" Class="mb-2">Attendance Statuses</MudText>
        <SimpleLookupManager TLookup="AttAttendanceStatus" Items="_attendanceStatuses" OnCreate="CreateAttendanceStatusAsync" OnSetActive="SetAttendanceStatusActiveAsync" />

        <MudDivider Class="my-4" />
        <MudText Typo="Typo.h6" Class="mb-2">Behaviour Categories</MudText>
        <SimpleLookupManager TLookup="IntBehaviourCategory" Items="_behaviourCategories" OnCreate="CreateBehaviourCategoryAsync" OnSetActive="SetBehaviourCategoryActiveAsync">
            <ExtraFields>
                <MudItem xs="12" sm="2"><MudCheckBox T="bool" @bind-Value="_newCategoryIsPositive" Label="Positive" /></MudItem>
            </ExtraFields>
            <HeaderExtra><MudTh>Positive</MudTh></HeaderExtra>
            <RowExtra Context="category"><MudTd DataLabel="Positive">@(category.IsPositive ? "Yes" : "No")</MudTd></RowExtra>
        </SimpleLookupManager>

        <MudDivider Class="my-4" />
        <MudText Typo="Typo.h6" Class="mb-2">Intervention Types</MudText>
        <SimpleLookupManager TLookup="IntInterventionType" Items="_interventionTypes" OnCreate="CreateInterventionTypeAsync" OnSetActive="SetInterventionTypeActiveAsync" />
    </MudTabPanel>

    <MudTabPanel Text="Assessment">
        <MudText Typo="Typo.h6" Class="mb-2">Assessment Categories</MudText>
        <SimpleLookupManager TLookup="AsmAssessmentCategory" Items="_assessmentCategories" OnCreate="CreateAssessmentCategoryAsync" OnSetActive="SetAssessmentCategoryActiveAsync" />

        <MudDivider Class="my-4" />
        <MudText Typo="Typo.h6" Class="mb-2">External Examination Boards</MudText>
        <SimpleLookupManager TLookup="AsmExternalExaminationBoard" Items="_externalExaminationBoards" OnCreate="CreateExternalExaminationBoardAsync" OnSetActive="SetExternalExaminationBoardActiveAsync" />

        <MudDivider Class="my-4" />
        <MudText Typo="Typo.h6" Class="mb-2">Special Result States</MudText>
        <SimpleLookupManager TLookup="AsmSpecialResultState" Items="_specialResultStates" OnCreate="CreateSpecialResultStateAsync" OnSetActive="SetSpecialResultStateActiveAsync" />

        <MudDivider Class="my-4" />
        <MudText Typo="Typo.h6" Class="mb-2">Result Aggregation Rules</MudText>
        <SimpleLookupManager TLookup="AsmResultAggregationRule" Items="_resultAggregationRules" OnCreate="CreateResultAggregationRuleAsync" OnSetActive="SetResultAggregationRuleActiveAsync" />
    </MudTabPanel>

    <MudTabPanel Text="Learning Resources">
        <MudText Typo="Typo.h6" Class="mb-2">Resource Types</MudText>
        <SimpleLookupManager TLookup="LrnResourceType" Items="_resourceTypes" OnCreate="CreateResourceTypeAsync" OnSetActive="SetResourceTypeActiveAsync" />

        <MudDivider Class="my-4" />
        <MudText Typo="Typo.h6" Class="mb-2">Evidence Types</MudText>
        <SimpleLookupManager TLookup="LrnEvidenceType" Items="_evidenceTypes" OnCreate="CreateEvidenceTypeAsync" OnSetActive="SetEvidenceTypeActiveAsync" />
    </MudTabPanel>

</MudTabs>

@code {
    private IReadOnlyList<AccessRole> _roles = [];
    private IReadOnlyList<AccessConfidentialityTier> _confidentialityTiers = [];
    private int _newTierRank;

    private IReadOnlyList<OrgEvaluationModel> _evaluationModels = [];
    private IReadOnlyList<OrgDeliveryMode> _deliveryModes = [];
    private IReadOnlyList<OrgMediumOfInstruction> _mediumsOfInstruction = [];
    private IReadOnlyList<OrgHolidayType> _holidayTypes = [];

    private IReadOnlyList<PplRelationshipType> _relationshipTypes = [];
    private IReadOnlyList<PplRestrictionType> _restrictionTypes = [];
    private IReadOnlyList<PplEmploymentStatus> _employmentStatuses = [];
    private IReadOnlyList<PplEnrollmentType> _enrollmentTypes = [];

    private IReadOnlyList<AttAttendanceStatus> _attendanceStatuses = [];
    private IReadOnlyList<IntBehaviourCategory> _behaviourCategories = [];
    private bool _newCategoryIsPositive;
    private IReadOnlyList<IntInterventionType> _interventionTypes = [];

    private IReadOnlyList<AsmAssessmentCategory> _assessmentCategories = [];
    private IReadOnlyList<AsmExternalExaminationBoard> _externalExaminationBoards = [];
    private IReadOnlyList<AsmSpecialResultState> _specialResultStates = [];
    private IReadOnlyList<AsmResultAggregationRule> _resultAggregationRules = [];

    private IReadOnlyList<LrnResourceType> _resourceTypes = [];
    private IReadOnlyList<LrnEvidenceType> _evidenceTypes = [];

    protected override async Task OnInitializedAsync()
    {
        _roles = await RoleAssignments.GetAllRolesAsync();
        _confidentialityTiers = await RoleAssignments.GetConfidentialityTiersAsync();

        _evaluationModels = await OrgAdmin.GetEvaluationModelsAsync();
        _holidayTypes = await OrgAdmin.GetHolidayTypesAsync();
        _deliveryModes = await CurriculumAdmin.GetAllDeliveryModesAsync();
        _mediumsOfInstruction = await CurriculumAdmin.GetAllMediumsOfInstructionAsync();

        _relationshipTypes = await PeopleAdmin.GetAllRelationshipTypesAsync();
        _restrictionTypes = await PeopleAdmin.GetAllRestrictionTypesAsync();
        _employmentStatuses = await PeopleAdmin.GetAllEmploymentStatusesAsync();
        _enrollmentTypes = await PeopleAdmin.GetAllEnrollmentTypesAsync();

        _attendanceStatuses = await AttendanceAdmin.GetAttendanceStatusesAsync();
        _behaviourCategories = await InterventionAdmin.GetBehaviourCategoriesAsync();
        _interventionTypes = await InterventionAdmin.GetInterventionTypesAsync();

        _assessmentCategories = await AssessmentConfig.GetAssessmentCategoriesAsync();
        _externalExaminationBoards = await AssessmentConfig.GetExternalExaminationBoardsAsync();
        _specialResultStates = await AssessmentConfig.GetSpecialResultStatesAsync();
        _resultAggregationRules = await AssessmentConfig.GetResultAggregationRulesAsync();

        _resourceTypes = await LessonPlanning.GetResourceTypesAsync();
        _evidenceTypes = await LessonPlanning.GetEvidenceTypesAsync();
    }

    private async Task CreateRoleAsync(string code, string name, int displayOrder)
    {
        await RoleAssignments.CreateRoleAsync(code, name, null, displayOrder);
        _roles = await RoleAssignments.GetAllRolesAsync();
        Snackbar.Add("Role created.", Severity.Success);
    }

    private async Task SetRoleActiveAsync(AccessRole role, bool isActive)
    {
        await RoleAssignments.SetRoleActiveAsync(role.Id, isActive);
        _roles = await RoleAssignments.GetAllRolesAsync();
    }

    private async Task CreateConfidentialityTierAsync(string code, string name, int displayOrder)
    {
        await RoleAssignments.CreateConfidentialityTierAsync(code, name, null, _newTierRank, displayOrder);
        _newTierRank = 0;
        _confidentialityTiers = await RoleAssignments.GetConfidentialityTiersAsync();
        Snackbar.Add("Confidentiality tier created.", Severity.Success);
    }

    private async Task SetConfidentialityTierActiveAsync(AccessConfidentialityTier tier, bool isActive)
    {
        await RoleAssignments.SetConfidentialityTierActiveAsync(tier.Id, isActive);
        _confidentialityTiers = await RoleAssignments.GetConfidentialityTiersAsync();
    }

    private async Task CreateEvaluationModelAsync(string code, string name, int displayOrder)
    {
        await OrgAdmin.CreateEvaluationModelAsync(code, name, null, displayOrder);
        _evaluationModels = await OrgAdmin.GetEvaluationModelsAsync();
        Snackbar.Add("Evaluation model created.", Severity.Success);
    }

    private async Task SetEvaluationModelActiveAsync(OrgEvaluationModel model, bool isActive)
    {
        await OrgAdmin.SetEvaluationModelActiveAsync(model.Id, isActive);
        _evaluationModels = await OrgAdmin.GetEvaluationModelsAsync();
    }

    private async Task CreateDeliveryModeAsync(string code, string name, int displayOrder)
    {
        await CurriculumAdmin.CreateDeliveryModeAsync(code, name, displayOrder);
        _deliveryModes = await CurriculumAdmin.GetAllDeliveryModesAsync();
        Snackbar.Add("Delivery mode created.", Severity.Success);
    }

    private async Task SetDeliveryModeActiveAsync(OrgDeliveryMode mode, bool isActive)
    {
        await CurriculumAdmin.SetDeliveryModeActiveAsync(mode.Id, isActive);
        _deliveryModes = await CurriculumAdmin.GetAllDeliveryModesAsync();
    }

    private async Task CreateMediumOfInstructionAsync(string code, string name, int displayOrder)
    {
        await CurriculumAdmin.CreateMediumOfInstructionAsync(code, name, displayOrder);
        _mediumsOfInstruction = await CurriculumAdmin.GetAllMediumsOfInstructionAsync();
        Snackbar.Add("Medium of instruction created.", Severity.Success);
    }

    private async Task SetMediumOfInstructionActiveAsync(OrgMediumOfInstruction medium, bool isActive)
    {
        await CurriculumAdmin.SetMediumOfInstructionActiveAsync(medium.Id, isActive);
        _mediumsOfInstruction = await CurriculumAdmin.GetAllMediumsOfInstructionAsync();
    }

    private async Task CreateHolidayTypeAsync(string code, string name, int displayOrder)
    {
        await OrgAdmin.CreateHolidayTypeAsync(code, name, displayOrder);
        _holidayTypes = await OrgAdmin.GetHolidayTypesAsync();
        Snackbar.Add("Holiday type created.", Severity.Success);
    }

    private async Task SetHolidayTypeActiveAsync(OrgHolidayType type, bool isActive)
    {
        await OrgAdmin.SetHolidayTypeActiveAsync(type.Id, isActive);
        _holidayTypes = await OrgAdmin.GetHolidayTypesAsync();
    }

    private async Task CreateRelationshipTypeAsync(string code, string name, int displayOrder)
    {
        await PeopleAdmin.CreateRelationshipTypeAsync(code, name, displayOrder);
        _relationshipTypes = await PeopleAdmin.GetAllRelationshipTypesAsync();
        Snackbar.Add("Relationship type created.", Severity.Success);
    }

    private async Task SetRelationshipTypeActiveAsync(PplRelationshipType type, bool isActive)
    {
        await PeopleAdmin.SetRelationshipTypeActiveAsync(type.Id, isActive);
        _relationshipTypes = await PeopleAdmin.GetAllRelationshipTypesAsync();
    }

    private async Task CreateRestrictionTypeAsync(string code, string name, int displayOrder)
    {
        await PeopleAdmin.CreateRestrictionTypeAsync(code, name, displayOrder);
        _restrictionTypes = await PeopleAdmin.GetAllRestrictionTypesAsync();
        Snackbar.Add("Restriction type created.", Severity.Success);
    }

    private async Task SetRestrictionTypeActiveAsync(PplRestrictionType type, bool isActive)
    {
        await PeopleAdmin.SetRestrictionTypeActiveAsync(type.Id, isActive);
        _restrictionTypes = await PeopleAdmin.GetAllRestrictionTypesAsync();
    }

    private async Task CreateEmploymentStatusAsync(string code, string name, int displayOrder)
    {
        await PeopleAdmin.CreateEmploymentStatusAsync(code, name, displayOrder);
        _employmentStatuses = await PeopleAdmin.GetAllEmploymentStatusesAsync();
        Snackbar.Add("Employment status created.", Severity.Success);
    }

    private async Task SetEmploymentStatusActiveAsync(PplEmploymentStatus status, bool isActive)
    {
        await PeopleAdmin.SetEmploymentStatusActiveAsync(status.Id, isActive);
        _employmentStatuses = await PeopleAdmin.GetAllEmploymentStatusesAsync();
    }

    private async Task CreateEnrollmentTypeAsync(string code, string name, int displayOrder)
    {
        await PeopleAdmin.CreateEnrollmentTypeAsync(code, name, displayOrder);
        _enrollmentTypes = await PeopleAdmin.GetAllEnrollmentTypesAsync();
        Snackbar.Add("Enrollment type created.", Severity.Success);
    }

    private async Task SetEnrollmentTypeActiveAsync(PplEnrollmentType type, bool isActive)
    {
        await PeopleAdmin.SetEnrollmentTypeActiveAsync(type.Id, isActive);
        _enrollmentTypes = await PeopleAdmin.GetAllEnrollmentTypesAsync();
    }

    private async Task CreateAttendanceStatusAsync(string code, string name, int displayOrder)
    {
        await AttendanceAdmin.CreateAttendanceStatusAsync(code, name, displayOrder);
        _attendanceStatuses = await AttendanceAdmin.GetAttendanceStatusesAsync();
        Snackbar.Add("Attendance status created.", Severity.Success);
    }

    private async Task SetAttendanceStatusActiveAsync(AttAttendanceStatus status, bool isActive)
    {
        await AttendanceAdmin.SetAttendanceStatusActiveAsync(status.Id, isActive);
        _attendanceStatuses = await AttendanceAdmin.GetAttendanceStatusesAsync();
    }

    private async Task CreateBehaviourCategoryAsync(string code, string name, int displayOrder)
    {
        await InterventionAdmin.CreateBehaviourCategoryAsync(code, name, _newCategoryIsPositive, displayOrder);
        _newCategoryIsPositive = false;
        _behaviourCategories = await InterventionAdmin.GetBehaviourCategoriesAsync();
        Snackbar.Add("Behaviour category created.", Severity.Success);
    }

    private async Task SetBehaviourCategoryActiveAsync(IntBehaviourCategory category, bool isActive)
    {
        await InterventionAdmin.SetBehaviourCategoryActiveAsync(category.Id, isActive);
        _behaviourCategories = await InterventionAdmin.GetBehaviourCategoriesAsync();
    }

    private async Task CreateInterventionTypeAsync(string code, string name, int displayOrder)
    {
        await InterventionAdmin.CreateInterventionTypeAsync(code, name, displayOrder);
        _interventionTypes = await InterventionAdmin.GetInterventionTypesAsync();
        Snackbar.Add("Intervention type created.", Severity.Success);
    }

    private async Task SetInterventionTypeActiveAsync(IntInterventionType type, bool isActive)
    {
        await InterventionAdmin.SetInterventionTypeActiveAsync(type.Id, isActive);
        _interventionTypes = await InterventionAdmin.GetInterventionTypesAsync();
    }

    private async Task CreateAssessmentCategoryAsync(string code, string name, int displayOrder)
    {
        await AssessmentConfig.CreateAssessmentCategoryAsync(code, name, displayOrder);
        _assessmentCategories = await AssessmentConfig.GetAssessmentCategoriesAsync();
        Snackbar.Add("Assessment category created.", Severity.Success);
    }

    private async Task SetAssessmentCategoryActiveAsync(AsmAssessmentCategory category, bool isActive)
    {
        await AssessmentConfig.SetAssessmentCategoryActiveAsync(category.Id, isActive);
        _assessmentCategories = await AssessmentConfig.GetAssessmentCategoriesAsync();
    }

    private async Task CreateExternalExaminationBoardAsync(string code, string name, int displayOrder)
    {
        await AssessmentConfig.CreateExternalExaminationBoardAsync(code, name, displayOrder);
        _externalExaminationBoards = await AssessmentConfig.GetExternalExaminationBoardsAsync();
        Snackbar.Add("External examination board created.", Severity.Success);
    }

    private async Task SetExternalExaminationBoardActiveAsync(AsmExternalExaminationBoard board, bool isActive)
    {
        await AssessmentConfig.SetExternalExaminationBoardActiveAsync(board.Id, isActive);
        _externalExaminationBoards = await AssessmentConfig.GetExternalExaminationBoardsAsync();
    }

    private async Task CreateSpecialResultStateAsync(string code, string name, int displayOrder)
    {
        await AssessmentConfig.CreateSpecialResultStateAsync(code, name, displayOrder);
        _specialResultStates = await AssessmentConfig.GetSpecialResultStatesAsync();
        Snackbar.Add("Special result state created.", Severity.Success);
    }

    private async Task SetSpecialResultStateActiveAsync(AsmSpecialResultState state, bool isActive)
    {
        await AssessmentConfig.SetSpecialResultStateActiveAsync(state.Id, isActive);
        _specialResultStates = await AssessmentConfig.GetSpecialResultStatesAsync();
    }

    private async Task CreateResultAggregationRuleAsync(string code, string name, int displayOrder)
    {
        await AssessmentConfig.CreateResultAggregationRuleAsync(code, name, displayOrder);
        _resultAggregationRules = await AssessmentConfig.GetResultAggregationRulesAsync();
        Snackbar.Add("Result aggregation rule created.", Severity.Success);
    }

    private async Task SetResultAggregationRuleActiveAsync(AsmResultAggregationRule rule, bool isActive)
    {
        await AssessmentConfig.SetResultAggregationRuleActiveAsync(rule.Id, isActive);
        _resultAggregationRules = await AssessmentConfig.GetResultAggregationRulesAsync();
    }

    private async Task CreateResourceTypeAsync(string code, string name, int displayOrder)
    {
        await LessonPlanning.CreateResourceTypeAsync(code, name, displayOrder);
        _resourceTypes = await LessonPlanning.GetResourceTypesAsync();
        Snackbar.Add("Resource type created.", Severity.Success);
    }

    private async Task SetResourceTypeActiveAsync(LrnResourceType type, bool isActive)
    {
        await LessonPlanning.SetResourceTypeActiveAsync(type.Id, isActive);
        _resourceTypes = await LessonPlanning.GetResourceTypesAsync();
    }

    private async Task CreateEvidenceTypeAsync(string code, string name, int displayOrder)
    {
        await LessonPlanning.CreateEvidenceTypeAsync(code, name, displayOrder);
        _evidenceTypes = await LessonPlanning.GetEvidenceTypesAsync();
        Snackbar.Add("Evidence type created.", Severity.Success);
    }

    private async Task SetEvidenceTypeActiveAsync(LrnEvidenceType type, bool isActive)
    {
        await LessonPlanning.SetEvidenceTypeActiveAsync(type.Id, isActive);
        _evidenceTypes = await LessonPlanning.GetEvidenceTypesAsync();
    }
}
