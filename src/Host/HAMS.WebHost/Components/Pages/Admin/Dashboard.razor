@page "/dashboard"
@using HAMS.WebHost.Components.Account
@attribute [Authorize(Policy = SystemOrSchoolAdminPolicy.Name)]
@rendermode InteractiveServer
@using HAMS.ReportingAnalyticsAudit.Application
@inject IDashboardQueryService DashboardQuery
@inject ISnackbar Snackbar

<PageTitle>Dashboard — HAMS</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Dashboard</MudText>

    @if (_academicYears is not null && _academicYears.Count > 0)
    {
        <MudSelect T="Guid" Value="_selectedAcademicYearId" ValueChanged="OnAcademicYearChangedAsync" Label="Academic year" Dense="true" Style="min-width: 220px">
            <MudSelectItem T="Guid" Value="Guid.Empty">(Select an academic year)</MudSelectItem>
            @foreach (var year in _academicYears)
            {
                <MudSelectItem Value="@year.AcademicYearId">@year.Name</MudSelectItem>
            }
        </MudSelect>
    }
</MudStack>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_academicYears is not null && _academicYears.Count == 0)
{
    <MudAlert Severity="Severity.Info">No enrolment data exists yet — the dashboard has nothing to summarize until at least one student is enrolled.</MudAlert>
}
else if (_snapshot is not null)
{
    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 hams-stat-card" Elevation="1">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Active Students</MudText>
                <MudText Typo="Typo.h3" Class="hams-stat-value">@_snapshot.TotalActiveStudents</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 hams-stat-card" Elevation="1">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Attendance Rate (30 days)</MudText>
                <MudText Typo="Typo.h3" Class="hams-stat-value">@_snapshot.AttendanceLast30Days.PresentRatePercent.ToString("0.#")%</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@_snapshot.AttendanceLast30Days.PresentCount of @_snapshot.AttendanceLast30Days.TotalRecords records</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 hams-stat-card" Elevation="1">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Open Intervention Cases</MudText>
                <MudText Typo="Typo.h3" Class="hams-stat-value">@_snapshot.InterventionCasesByType.Sum(c => c.OpenCount)</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-4 hams-stat-card" Elevation="1">
                <MudText Typo="Typo.body2" Color="Color.Secondary">Promotion Decisions</MudText>
                <MudText Typo="Typo.h3" Class="hams-stat-value">@_snapshot.PromotionDecisions.PromotedCount / @(_snapshot.PromotionDecisions.PromotedCount + _snapshot.PromotionDecisions.NotPromotedCount)</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">promoted of recorded decisions</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-2">Enrolment by Grade</MudText>
                @if (_snapshot.EnrollmentByGrade.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">No active enrolments for this academic year.</MudText>
                }
                else
                {
                    var maxCount = _snapshot.EnrollmentByGrade.Max(e => e.StudentCount);
                    @foreach (var grade in _snapshot.EnrollmentByGrade)
                    {
                        <div class="mb-3">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-1">
                                <MudText Typo="Typo.body2">@grade.GradeName</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@grade.StudentCount</MudText>
                            </MudStack>
                            <MudProgressLinear Color="Color.Primary" Value="@(maxCount == 0 ? 0 : 100.0 * grade.StudentCount / maxCount)" Rounded="true" Size="Size.Large" />
                        </div>
                    }
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-2">Intervention Cases by Type</MudText>
                @if (_snapshot.InterventionCasesByType.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">No intervention cases recorded for this academic year.</MudText>
                }
                else
                {
                    <MudTable Items="@_snapshot.InterventionCasesByType" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>Type</MudTh>
                            <MudTh>Open</MudTh>
                            <MudTh>Closed</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Type">@context.InterventionTypeName</MudTd>
                            <MudTd DataLabel="Open">@context.OpenCount</MudTd>
                            <MudTd DataLabel="Closed">@context.ClosedCount</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private IReadOnlyList<AcademicYearOption>? _academicYears;
    private Guid _selectedAcademicYearId;
    private DashboardSnapshot? _snapshot;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _academicYears = await DashboardQuery.GetAvailableAcademicYearsAsync();
            if (_academicYears.Count > 0)
            {
                _selectedAcademicYearId = _academicYears[0].AcademicYearId;
                await LoadSnapshotAsync();
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Could not load dashboard data.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnAcademicYearChangedAsync(Guid academicYearId)
    {
        _selectedAcademicYearId = academicYearId;
        _loading = true;
        await LoadSnapshotAsync();
        _loading = false;
    }

    private async Task LoadSnapshotAsync()
    {
        _snapshot = await DashboardQuery.GetSnapshotAsync(_selectedAcademicYearId);
    }
}
