    private void StartAssessmentEdit(Assessment assessment)
    {
        _editingAssessmentId = assessment.Id;
        _editAssessmentTitle = assessment.Title;
        _editAssessmentMaxMarks = assessment.MaxMarks;
        _editAssessmentDurationMinutes = assessment.DurationMinutes;
        _editAssessmentScheduledDate = assessment.ScheduledDate.ToDateTime(TimeOnly.MinValue);
        _editAssessmentExamBoardCode = assessment.ExternalExaminationBoardId is { } boardId
            ? _examBoards.SingleOrDefault(b => b.Id == boardId)?.Code
            : null;
        _editAssessmentExternalSyllabusCode = assessment.ExternalSyllabusCode;
    }

    private async Task SaveAssessmentEditAsync()
    {
        if (_editingAssessmentId is not { } id || _editAssessmentScheduledDate is not { } scheduledDate) return;

        try
        {
            await AssessmentConfig.UpdateAssessmentAsync(
                id, _editAssessmentTitle, _editAssessmentMaxMarks, _editAssessmentDurationMinutes,
                _editAssessmentExamBoardCode, _editAssessmentExternalSyllabusCode, DateOnly.FromDateTime(scheduledDate));
            _editingAssessmentId = null;
            Snackbar.Add("Assessment updated.", Severity.Success);
            _assessments = await AssessmentConfig.GetAssessmentsAsync(_selectedSubjectId, _selectedGradeId, _selectedTermId);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
