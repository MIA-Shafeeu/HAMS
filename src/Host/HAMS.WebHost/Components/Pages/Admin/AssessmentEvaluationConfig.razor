    protected override async Task OnInitializedAsync()
    {
        _schemes = await AssessmentConfig.GetAssessmentSchemesAsync();
        _gradeScales = await AssessmentConfig.GetGradeScalesAsync();
        _promotionPolicies = await AssessmentConfig.GetPromotionPoliciesAsync();
        _categories = await AssessmentConfig.GetAssessmentCategoriesAsync();
        _aggregationRules = await AssessmentConfig.GetResultAggregationRulesAsync();
        _examBoards = await AssessmentConfig.GetExternalExaminationBoardsAsync();
        _schools = await OrgAdmin.GetSchoolsAsync();
    }

    private async Task CreateSchemeAsync()
    {
        if (string.IsNullOrWhiteSpace(_newSchemeCode) || string.IsNullOrWhiteSpace(_newSchemeName))
        {
            Snackbar.Add("Code and name are required.", Severity.Warning);
            return;
        }

        await AssessmentConfig.CreateAssessmentSchemeAsync(_newSchemeCode, _newSchemeName);
        _newSchemeCode = ""; _newSchemeName = "";
        _schemes = await AssessmentConfig.GetAssessmentSchemesAsync();
        Snackbar.Add("Assessment scheme created.", Severity.Success);
    }

    private async Task SelectSchemeAsync(Guid schemeId)
    {
        _selectedSchemeId = schemeId;
        _schemeComponents = await AssessmentConfig.GetAssessmentSchemeComponentsAsync(schemeId);
    }

    private void StartSchemeEdit(AssessmentScheme scheme)
    {
        _editingSchemeId = scheme.Id;
        _editSchemeName = scheme.Name;
        _editSchemeDisplayOrder = scheme.DisplayOrder;
    }

    private async Task SaveSchemeEditAsync()
    {
        if (_editingSchemeId is not { } id) return;

        await AssessmentConfig.UpdateAssessmentSchemeAsync(id, _editSchemeName, _editSchemeDisplayOrder);
        _editingSchemeId = null;
        Snackbar.Add("Assessment scheme updated.", Severity.Success);
        _schemes = await AssessmentConfig.GetAssessmentSchemesAsync();
    }

