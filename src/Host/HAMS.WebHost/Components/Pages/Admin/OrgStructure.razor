@page "/admin/org-structure"
@using HAMS.WebHost.Components.Account
@attribute [Authorize(Policy = SystemOrSchoolAdminPolicy.Name)]
@rendermode InteractiveServer
@using HAMS.OrgCurriculum.Application
@using OrgSchool = HAMS.OrgCurriculum.Domain.School
@using OrgCampus = HAMS.OrgCurriculum.Domain.Campus
@using OrgAcademicYear = HAMS.OrgCurriculum.Domain.AcademicYear
@using OrgTerm = HAMS.OrgCurriculum.Domain.Term
@using OrgPhase = HAMS.OrgCurriculum.Domain.Phase
@using OrgKeyStage = HAMS.OrgCurriculum.Domain.KeyStage
@using OrgKeyStagePolicy = HAMS.OrgCurriculum.Domain.KeyStagePolicy
@using OrgGrade = HAMS.OrgCurriculum.Domain.Grade
@using OrgClass = HAMS.OrgCurriculum.Domain.Class
@using HAMS.Platform.Common.Contracts
@inject IOrgAdminService OrgAdmin
@inject ISnackbar Snackbar

<PageTitle>Org &amp; Academic Structure — HAMS</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">System Administration — Org &amp; Academic Structure</MudText>

<MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true">

    <MudTabPanel Text="Schools">
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="4"><MudTextField T="string" @bind-Value="_newSchoolCode" Label="Code" /></MudItem>
            <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="_newSchoolName" Label="Name" /></MudItem>
            <MudItem xs="12" sm="2" Class="d-flex align-end"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateSchoolAsync">Create</MudButton></MudItem>
        </MudGrid>
        <MudTable Items="@_schools" Dense="true" Hover="true" Class="mb-4">
            <HeaderContent><MudTh>Code</MudTh><MudTh>Name</MudTh><MudTh></MudTh></HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Code">@context.Code</MudTd>
                @if (_editingSchoolId == context.Id)
                {
                    <MudTd DataLabel="Name"><MudTextField T="string" @bind-Value="_editSchoolName" Margin="Margin.Dense" /></MudTd>
                    <MudTd>
                        <MudStack Row="true" Spacing="1">
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success" OnClick="SaveSchoolEditAsync">Save</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => _editingSchoolId = null)">Cancel</MudButton>
                        </MudStack>
                    </MudTd>
                }
                else
                {
                    <MudTd DataLabel="Name">@context.Name</MudTd>
                    <MudTd>
                        <MudStack Row="true" Spacing="1">
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => StartSchoolEdit(context))">Edit</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => SelectSchoolAsync(context.Id))">Manage Campuses</MudButton>
                        </MudStack>
                    </MudTd>
                }
            </RowTemplate>
        </MudTable>

        @if (_selectedSchoolIdForCampuses != Guid.Empty)
        {
            <MudText Typo="Typo.h6" Class="mb-2">Campuses — @_schools.SingleOrDefault(s => s.Id == _selectedSchoolIdForCampuses)?.Name</MudText>
            <MudTable Items="@_campuses" Dense="true" Hover="true" Class="mb-3">
                <HeaderContent><MudTh>Code</MudTh><MudTh>Name</MudTh><MudTh></MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Code">@context.Code</MudTd>
                    @if (_editingCampusId == context.Id)
                    {
                        <MudTd DataLabel="Name"><MudTextField T="string" @bind-Value="_editCampusName" Margin="Margin.Dense" /></MudTd>
                        <MudTd>
                            <MudStack Row="true" Spacing="1">
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success" OnClick="SaveCampusEditAsync">Save</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => _editingCampusId = null)">Cancel</MudButton>
                            </MudStack>
                        </MudTd>
                    }
                    else
                    {
                        <MudTd DataLabel="Name">@context.Name</MudTd>
                        <MudTd><MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => StartCampusEdit(context))">Edit</MudButton></MudTd>
                    }
                </RowTemplate>
            </MudTable>
            <MudGrid>
                <MudItem xs="12" sm="4"><MudTextField T="string" @bind-Value="_newCampusCode" Label="Code" /></MudItem>
                <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="_newCampusName" Label="Name" /></MudItem>
                <MudItem xs="12" sm="2" Class="d-flex align-end"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateCampusAsync">Add</MudButton></MudItem>
            </MudGrid>
        }
    </MudTabPanel>

    <MudTabPanel Text="Academic Years &amp; Terms">
        <MudSelect T="Guid" Value="_selectedSchoolIdForYears" ValueChanged="OnSchoolChangedForYearsAsync" Label="School" Dense="true" Class="mb-4">
            @foreach (var school in _schools) { <MudSelectItem T="Guid" Value="@school.Id">@school.Name</MudSelectItem> }
        </MudSelect>

        @if (_selectedSchoolIdForYears != Guid.Empty)
        {
            <MudGrid Class="mb-4">
                <MudItem xs="12" sm="2"><MudTextField T="string" @bind-Value="_newYearCode" Label="Code" /></MudItem>
                <MudItem xs="12" sm="3"><MudTextField T="string" @bind-Value="_newYearName" Label="Name" /></MudItem>
                <MudItem xs="12" sm="3"><MudDatePicker Label="Start date" Date="_newYearStart" DateChanged="d => _newYearStart = d" /></MudItem>
                <MudItem xs="12" sm="3"><MudDatePicker Label="End date" Date="_newYearEnd" DateChanged="d => _newYearEnd = d" /></MudItem>
                <MudItem xs="12" sm="1" Class="d-flex align-end"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateAcademicYearAsync">Add</MudButton></MudItem>
            </MudGrid>

            <MudTable Items="@_academicYears" Dense="true" Hover="true" Class="mb-4">
                <HeaderContent><MudTh>Code</MudTh><MudTh>Name</MudTh><MudTh>Start</MudTh><MudTh>End</MudTh><MudTh></MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Code">@context.Code</MudTd>
                    @if (_editingAcademicYearId == context.Id)
                    {
                        <MudTd DataLabel="Name"><MudTextField T="string" @bind-Value="_editYearName" Margin="Margin.Dense" /></MudTd>
                        <MudTd DataLabel="Start"><MudDatePicker Date="_editYearStart" DateChanged="d => _editYearStart = d" Margin="Margin.Dense" /></MudTd>
                        <MudTd DataLabel="End"><MudDatePicker Date="_editYearEnd" DateChanged="d => _editYearEnd = d" Margin="Margin.Dense" /></MudTd>
                        <MudTd>
                            <MudStack Row="true" Spacing="1">
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success" OnClick="SaveAcademicYearEditAsync">Save</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => _editingAcademicYearId = null)">Cancel</MudButton>
                            </MudStack>
                        </MudTd>
                    }
                    else
                    {
                        <MudTd DataLabel="Name">@context.Name</MudTd>
                        <MudTd DataLabel="Start">@context.StartDate.ToString("yyyy-MM-dd")</MudTd>
                        <MudTd DataLabel="End">@context.EndDate.ToString("yyyy-MM-dd")</MudTd>
                        <MudTd>
                            <MudStack Row="true" Spacing="1">
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => StartAcademicYearEdit(context))">Edit</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => SelectAcademicYearAsync(context.Id))">Manage Terms</MudButton>
                            </MudStack>
                        </MudTd>
                    }
                </RowTemplate>
            </MudTable>

            @if (_selectedAcademicYearIdForTerms != Guid.Empty)
            {
                <MudText Typo="Typo.h6" Class="mb-2">Terms</MudText>
                <MudTable Items="@_terms" Dense="true" Hover="true" Class="mb-3">
                    <HeaderContent><MudTh>Code</MudTh><MudTh>Name</MudTh><MudTh>Start</MudTh><MudTh>End</MudTh><MudTh>Order</MudTh><MudTh></MudTh></HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Code">@context.Code</MudTd>
                        @if (_editingTermId == context.Id)
                        {
                            <MudTd DataLabel="Name"><MudTextField T="string" @bind-Value="_editTermName" Margin="Margin.Dense" /></MudTd>
                            <MudTd DataLabel="Start"><MudDatePicker Date="_editTermStart" DateChanged="d => _editTermStart = d" Margin="Margin.Dense" /></MudTd>
                            <MudTd DataLabel="End"><MudDatePicker Date="_editTermEnd" DateChanged="d => _editTermEnd = d" Margin="Margin.Dense" /></MudTd>
                            <MudTd DataLabel="Order"><MudNumericField T="int" @bind-Value="_editTermDisplayOrder" Margin="Margin.Dense" /></MudTd>
                            <MudTd>
                                <MudStack Row="true" Spacing="1">
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success" OnClick="SaveTermEditAsync">Save</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => _editingTermId = null)">Cancel</MudButton>
                                </MudStack>
                            </MudTd>
                        }
                        else
                        {
                            <MudTd DataLabel="Name">@context.Name</MudTd>
                            <MudTd DataLabel="Start">@context.StartDate.ToString("yyyy-MM-dd")</MudTd>
                            <MudTd DataLabel="End">@context.EndDate.ToString("yyyy-MM-dd")</MudTd>
                            <MudTd DataLabel="Order">@context.DisplayOrder</MudTd>
                            <MudTd><MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => StartTermEdit(context))">Edit</MudButton></MudTd>
                        }
                    </RowTemplate>
                </MudTable>
                <MudGrid>
                    <MudItem xs="12" sm="2"><MudTextField T="string" @bind-Value="_newTermCode" Label="Code" /></MudItem>
                    <MudItem xs="12" sm="3"><MudTextField T="string" @bind-Value="_newTermName" Label="Name" /></MudItem>
                    <MudItem xs="12" sm="2"><MudDatePicker Label="Start" Date="_newTermStart" DateChanged="d => _newTermStart = d" /></MudItem>
                    <MudItem xs="12" sm="2"><MudDatePicker Label="End" Date="_newTermEnd" DateChanged="d => _newTermEnd = d" /></MudItem>
                    <MudItem xs="12" sm="2"><MudNumericField T="int" @bind-Value="_newTermDisplayOrder" Label="Order" /></MudItem>
                    <MudItem xs="12" sm="1" Class="d-flex align-end"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateTermAsync">Add</MudButton></MudItem>
                </MudGrid>
            }
        }
    </MudTabPanel>

    <MudTabPanel Text="Phases &amp; Key Stages">
        <MudSelect T="Guid" Value="_selectedSchoolIdForPhases" ValueChanged="OnSchoolChangedForPhasesAsync" Label="School" Dense="true" Class="mb-4">
            @foreach (var school in _schools) { <MudSelectItem T="Guid" Value="@school.Id">@school.Name</MudSelectItem> }
        </MudSelect>

        @if (_selectedSchoolIdForPhases != Guid.Empty)
        {
            <MudGrid Class="mb-4">
                <MudItem xs="12" sm="3"><MudTextField T="string" @bind-Value="_newPhaseCode" Label="Code" /></MudItem>
                <MudItem xs="12" sm="5"><MudTextField T="string" @bind-Value="_newPhaseName" Label="Name" /></MudItem>
                <MudItem xs="12" sm="3"><MudNumericField T="int" @bind-Value="_newPhaseDisplayOrder" Label="Display order" /></MudItem>
                <MudItem xs="12" sm="1" Class="d-flex align-end"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreatePhaseAsync">Add</MudButton></MudItem>
            </MudGrid>

            <MudTable Items="@_phases" Dense="true" Hover="true" Class="mb-4">
                <HeaderContent><MudTh>Code</MudTh><MudTh>Name</MudTh><MudTh>Order</MudTh><MudTh></MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Code">@context.Code</MudTd>
                    @if (_editingPhaseId == context.Id)
                    {
                        <MudTd DataLabel="Name"><MudTextField T="string" @bind-Value="_editPhaseName" Margin="Margin.Dense" /></MudTd>
                        <MudTd DataLabel="Order"><MudNumericField T="int" @bind-Value="_editPhaseDisplayOrder" Margin="Margin.Dense" /></MudTd>
                        <MudTd>
                            <MudStack Row="true" Spacing="1">
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success" OnClick="SavePhaseEditAsync">Save</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => _editingPhaseId = null)">Cancel</MudButton>
                            </MudStack>
                        </MudTd>
                    }
                    else
                    {
                        <MudTd DataLabel="Name">@context.Name</MudTd>
                        <MudTd DataLabel="Order">@context.DisplayOrder</MudTd>
                        <MudTd>
                            <MudStack Row="true" Spacing="1">
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => StartPhaseEdit(context))">Edit</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => SelectPhaseAsync(context.Id))">Manage Key Stages</MudButton>
                            </MudStack>
                        </MudTd>
                    }
                </RowTemplate>
            </MudTable>

            @if (_selectedPhaseId != Guid.Empty)
            {
                <MudText Typo="Typo.h6" Class="mb-2">Key Stages</MudText>
                <MudTable Items="@_keyStages" Dense="true" Hover="true" Class="mb-3">
                    <HeaderContent><MudTh>Code</MudTh><MudTh>Name</MudTh><MudTh>Order</MudTh><MudTh></MudTh></HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Code">@context.Code</MudTd>
                        @if (_editingKeyStageId == context.Id)
                        {
                            <MudTd DataLabel="Name"><MudTextField T="string" @bind-Value="_editKeyStageName" Margin="Margin.Dense" /></MudTd>
                            <MudTd DataLabel="Order"><MudNumericField T="int" @bind-Value="_editKeyStageDisplayOrder" Margin="Margin.Dense" /></MudTd>
                            <MudTd>
                                <MudStack Row="true" Spacing="1">
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success" OnClick="SaveKeyStageEditAsync">Save</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => _editingKeyStageId = null)">Cancel</MudButton>
                                </MudStack>
                            </MudTd>
                        }
                        else
                        {
                            <MudTd DataLabel="Name">@context.Name</MudTd>
                            <MudTd DataLabel="Order">@context.DisplayOrder</MudTd>
                            <MudTd><MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => StartKeyStageEdit(context))">Edit</MudButton></MudTd>
                        }
                    </RowTemplate>
                </MudTable>
                <MudGrid>
                    <MudItem xs="12" sm="3"><MudTextField T="string" @bind-Value="_newKeyStageCode" Label="Code" /></MudItem>
                    <MudItem xs="12" sm="5"><MudTextField T="string" @bind-Value="_newKeyStageName" Label="Name" /></MudItem>
                    <MudItem xs="12" sm="3"><MudNumericField T="int" @bind-Value="_newKeyStageDisplayOrder" Label="Display order" /></MudItem>
                    <MudItem xs="12" sm="1" Class="d-flex align-end"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateKeyStageAsync">Add</MudButton></MudItem>
                </MudGrid>
            }
        }
    </MudTabPanel>

    <MudTabPanel Text="Key Stage Policies">
        <MudAlert Severity="Severity.Info" Class="mb-4">
            The evaluation-model cascade: set exactly one policy per key stage per academic year. Every grade assigned to that key stage automatically inherits it — this is the single most important configuration screen in the system.
        </MudAlert>
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6">
                <MudSelect T="Guid" Value="_selectedSchoolIdForKeyStagePolicies" ValueChanged="OnSchoolChangedForKeyStagePoliciesAsync" Label="School" Dense="true">
                    @foreach (var school in _schools) { <MudSelectItem T="Guid" Value="@school.Id">@school.Name</MudSelectItem> }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="Guid" @bind-Value="_policyKeyStageId" Label="Key stage" Dense="true" Disabled="@(_allKeyStagesForSchool.Count == 0)">
                    @foreach (var keyStage in _allKeyStagesForSchool) { <MudSelectItem T="Guid" Value="@keyStage.Id">@keyStage.Name</MudSelectItem> }
                </MudSelect>
            </MudItem>
        </MudGrid>

        @if (_selectedSchoolIdForKeyStagePolicies != Guid.Empty)
        {
            <MudGrid Class="mb-4">
                <MudItem xs="12" sm="4">
                    <MudSelect T="Guid" @bind-Value="_policyAcademicYearId" Label="Academic year" Dense="true">
                        @foreach (var year in _academicYears) { <MudSelectItem T="Guid" Value="@year.Id">@year.Name</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="string" @bind-Value="_newPolicyEvaluationModelCode" Label="Evaluation model code" Dense="true">
                        <MudSelectItem T="string" Value="@("MASTERY")">Mastery</MudSelectItem>
                        <MudSelectItem T="string" Value="@("ASSESSMENT")">Assessment</MudSelectItem>
                        <MudSelectItem T="string" Value="@("HYBRID")">Hybrid</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4" Class="d-flex align-end">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateKeyStagePolicyAsync" Disabled="@(_policyKeyStageId == Guid.Empty)">Create Draft Policy</MudButton>
                </MudItem>
            </MudGrid>

            @if (_keyStagePolicies.Count > 0)
            {
                <MudTable Items="@_keyStagePolicies" Dense="true" Hover="true">
                    <HeaderContent><MudTh>Status</MudTh><MudTh>Current</MudTh><MudTh></MudTh></HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Status">@context.Status</MudTd>
                        <MudTd DataLabel="Current">@(context.IsCurrent ? "Yes" : "No")</MudTd>
                        <MudTd>
                            @if (context.Status == HAMS.Platform.Common.Contracts.RecordStatus.Draft)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" OnClick="@(() => PublishKeyStagePolicyAsync(context.Id))">Publish</MudButton>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        }
    </MudTabPanel>

    <MudTabPanel Text="Grades">
        <MudSelect T="Guid" Value="_selectedSchoolIdForGrades" ValueChanged="OnSchoolChangedForGradesAsync" Label="School" Dense="true" Class="mb-4">
            @foreach (var school in _schools) { <MudSelectItem T="Guid" Value="@school.Id">@school.Name</MudSelectItem> }
        </MudSelect>

        @if (_selectedSchoolIdForGrades != Guid.Empty)
        {
            <MudGrid Class="mb-4">
                <MudItem xs="12" sm="3"><MudTextField T="string" @bind-Value="_newGradeCode" Label="Code" /></MudItem>
                <MudItem xs="12" sm="5"><MudTextField T="string" @bind-Value="_newGradeName" Label="Name" /></MudItem>
                <MudItem xs="12" sm="3"><MudNumericField T="int" @bind-Value="_newGradeDisplayOrder" Label="Display order" /></MudItem>
                <MudItem xs="12" sm="1" Class="d-flex align-end"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateGradeAsync">Add</MudButton></MudItem>
            </MudGrid>

            <MudTable Items="@_grades" Dense="true" Hover="true">
                <HeaderContent><MudTh>Code</MudTh><MudTh>Name</MudTh><MudTh>Order</MudTh><MudTh>Next Grade</MudTh><MudTh></MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Code">@context.Code</MudTd>
                    @if (_editingGradeId == context.Id)
                    {
                        <MudTd DataLabel="Name"><MudTextField T="string" @bind-Value="_editGradeName" Margin="Margin.Dense" /></MudTd>
                        <MudTd DataLabel="Order"><MudNumericField T="int" @bind-Value="_editGradeDisplayOrder" Margin="Margin.Dense" /></MudTd>
                        <MudTd DataLabel="Next Grade">-</MudTd>
                        <MudTd>
                            <MudStack Row="true" Spacing="1">
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success" OnClick="SaveGradeEditAsync">Save</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => _editingGradeId = null)">Cancel</MudButton>
                            </MudStack>
                        </MudTd>
                    }
                    else
                    {
                        <MudTd DataLabel="Name">@context.Name</MudTd>
                        <MudTd DataLabel="Order">@context.DisplayOrder</MudTd>
                        <MudTd DataLabel="Next Grade">
                            <MudSelect T="Guid" Value="@(context.NextGradeId ?? Guid.Empty)" ValueChanged="@(id => SetNextGradeAsync(context.Id, id))" Dense="true" Margin="Margin.Dense">
                                <MudSelectItem T="Guid" Value="Guid.Empty">(none)</MudSelectItem>
                                @foreach (var grade in _grades.Where(g => g.Id != context.Id)) { <MudSelectItem T="Guid" Value="@grade.Id">@grade.Name</MudSelectItem> }
                            </MudSelect>
                        </MudTd>
                        <MudTd><MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => StartGradeEdit(context))">Edit</MudButton></MudTd>
                    }
                </RowTemplate>
            </MudTable>
        }
    </MudTabPanel>

    <MudTabPanel Text="Classes">
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6">
                <MudSelect T="Guid" Value="_selectedSchoolIdForClasses" ValueChanged="OnSchoolChangedForClassesAsync" Label="School" Dense="true">
                    @foreach (var school in _schools) { <MudSelectItem T="Guid" Value="@school.Id">@school.Name</MudSelectItem> }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="Guid" Value="_selectedAcademicYearIdForClasses" ValueChanged="OnAcademicYearChangedForClassesAsync" Label="Academic year" Dense="true" Disabled="@(_academicYears.Count == 0)">
                    @foreach (var year in _academicYears) { <MudSelectItem T="Guid" Value="@year.Id">@year.Name</MudSelectItem> }
                </MudSelect>
            </MudItem>
        </MudGrid>

        @if (_selectedAcademicYearIdForClasses != Guid.Empty)
        {
            <MudGrid Class="mb-4">
                <MudItem xs="12" sm="3"><MudTextField T="string" @bind-Value="_newClassCode" Label="Code" /></MudItem>
                <MudItem xs="12" sm="3"><MudTextField T="string" @bind-Value="_newClassName" Label="Name" /></MudItem>
                <MudItem xs="12" sm="5">
                    <MudSelect T="Guid" MultiSelection="true" @bind-SelectedValues="_newClassGradeIds" Label="Grades (select one or more — more than one means a combined class)" Dense="true">
                        @foreach (var grade in _grades) { <MudSelectItem T="Guid" Value="@grade.Id">@grade.Name</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="1" Class="d-flex align-end"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateClassAsync">Add</MudButton></MudItem>
            </MudGrid>

            <MudTable Items="@_classes" Dense="true" Hover="true">
                <HeaderContent><MudTh>Code</MudTh><MudTh>Name</MudTh><MudTh></MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Code">@context.Code</MudTd>
                    @if (_editingClassId == context.Id)
                    {
                        <MudTd DataLabel="Name">
                            <MudTextField T="string" @bind-Value="_editClassName" Margin="Margin.Dense" Class="mb-2" />
                            <MudSelect T="Guid" MultiSelection="true" @bind-SelectedValues="_editClassGradeIds" Label="Grades" Dense="true" Margin="Margin.Dense">
                                @foreach (var grade in _grades) { <MudSelectItem T="Guid" Value="@grade.Id">@grade.Name</MudSelectItem> }
                            </MudSelect>
                        </MudTd>
                        <MudTd>
                            <MudStack Row="true" Spacing="1">
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Success" OnClick="SaveClassEditAsync">Save</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => _editingClassId = null)">Cancel</MudButton>
                            </MudStack>
                        </MudTd>
                    }
                    else
                    {
                        <MudTd DataLabel="Name">@context.Name</MudTd>
                        <MudTd><MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => StartClassEdit(context))">Edit</MudButton></MudTd>
                    }
                </RowTemplate>
            </MudTable>
        }
    </MudTabPanel>

</MudTabs>

