@page "/audit-log"
@using HAMS.WebHost.Components.Account
@attribute [Authorize(Policy = SystemOrSchoolAdminPolicy.Name)]
@rendermode InteractiveServer
@using HAMS.Platform.Audit
@using HAMS.Platform.Audit.Domain
@inject IAuditLogQuery AuditLogQuery
@inject ISnackbar Snackbar

<PageTitle>Audit Log — HAMS</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Audit Log</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker Label="From date" @bind-Date="_fromDate" Editable="true" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker Label="To date" @bind-Date="_toDate" Editable="true" />
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="AuditAction?" Label="Action" @bind-Value="_action" Clearable="true">
                @foreach (var action in Enum.GetValues<AuditAction>())
                {
                    <MudSelectItem T="AuditAction?" Value="@action">@action</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="string" Label="Entity type" @bind-Value="_entityType" Clearable="true">
                @foreach (var entityType in _entityTypes)
                {
                    <MudSelectItem T="string" Value="@entityType">@entityType</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudTextField T="string" Label="Search summary text" @bind-Value="_searchText" Immediate="true" DebounceInterval="400" OnDebounceIntervalElapsed="@((_) => ReloadAsync())" />
        </MudItem>
        <MudItem xs="12" md="6" Class="d-flex align-center justify-end ga-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => ReloadAsync())">Apply Filters</MudButton>
            <MudButton Variant="Variant.Text" OnClick="ClearFiltersAsync">Clear</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTable @ref="_table" ServerData="ServerReloadAsync" Dense="true" Hover="true" Striped="true">
    <HeaderContent>
        <MudTh>Occurred</MudTh>
        <MudTh>Action</MudTh>
        <MudTh>Entity</MudTh>
        <MudTh>Actor</MudTh>
        <MudTh>Summary</MudTh>
        <MudTh>IP Address</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Occurred">@context.OccurredAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
        <MudTd DataLabel="Action"><MudChip T="string" Size="Size.Small" Color="@ActionColor(context.Action)">@context.Action</MudChip></MudTd>
        <MudTd DataLabel="Entity">@context.EntityType @(string.IsNullOrEmpty(context.EntityId) ? "" : $"#{context.EntityId}")</MudTd>
        <MudTd DataLabel="Actor">@(context.ActorPersonId?.ToString() ?? "(system)")</MudTd>
        <MudTd DataLabel="Summary">@context.Summary</MudTd>
        <MudTd DataLabel="IP Address">@(context.IpAddress ?? "—")</MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText>No audit entries match the current filters.</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="new[] { 25, 50, 100 }" />
    </PagerContent>
</MudTable>

@code {
    private MudTable<AuditLogEntry>? _table;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private AuditAction? _action;
    private string? _entityType;
    private string _searchText = "";
    private IReadOnlyList<string> _entityTypes = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _entityTypes = await AuditLogQuery.GetDistinctEntityTypesAsync();
        }
        catch (Exception)
        {
            Snackbar.Add("Could not load entity type filters.", Severity.Error);
        }
    }

    private Task ReloadAsync() => _table?.ReloadServerData() ?? Task.CompletedTask;

    private async Task ClearFiltersAsync()
    {
        _fromDate = null;
        _toDate = null;
        _action = null;
        _entityType = null;
        _searchText = "";
        await ReloadAsync();
    }

    private async Task<TableData<AuditLogEntry>> ServerReloadAsync(TableState state, CancellationToken cancellationToken)
    {
        var request = new AuditLogSearchRequest(
            FromUtc: _fromDate is { } from ? new DateTimeOffset(from, TimeSpan.Zero) : null,
            ToUtc: _toDate is { } to ? new DateTimeOffset(to.AddDays(1), TimeSpan.Zero) : null,
            Action: _action,
            EntityType: _entityType,
            SearchText: string.IsNullOrWhiteSpace(_searchText) ? null : _searchText,
            Page: state.Page + 1,
            PageSize: state.PageSize);

        try
        {
            var result = await AuditLogQuery.SearchAsync(request, cancellationToken);
            return new TableData<AuditLogEntry> { Items = result.Entries, TotalItems = result.TotalCount };
        }
        catch (Exception)
        {
            Snackbar.Add("Could not load audit log entries.", Severity.Error);
            return new TableData<AuditLogEntry> { Items = [], TotalItems = 0 };
        }
    }

    private static Color ActionColor(AuditAction action) => action switch
    {
        AuditAction.Create => Color.Success,
        AuditAction.Update => Color.Info,
        AuditAction.Delete => Color.Error,
        AuditAction.PermissionDenied => Color.Error,
        AuditAction.LoginFailed => Color.Warning,
        AuditAction.Login => Color.Success,
        AuditAction.Logout => Color.Default,
        AuditAction.Read => Color.Default,
        _ => Color.Default,
    };
}
