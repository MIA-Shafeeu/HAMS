@page "/assessment-marks"
@using HAMS.WebHost.Components.Account
@attribute [Authorize(Policy = StaffPolicy.Name)]
@rendermode InteractiveServer
@using HAMS.AssessmentEvaluation.Application
@using HAMS.IdentityAccess.Application.Jwt
@using HAMS.OrgCurriculum.Application
@using HAMS.PeopleEnrollment.Application
@using HAMS.Platform.Access
@using HAMS.Platform.Common.Contracts
@using HAMS.Platform.Workflow.Domain
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject IOrgStructureLookup OrgLookup
@inject IStudentEnrollmentService EnrollmentService
@inject IKeyStagePolicyResolver PolicyResolver
@inject IAssessmentLookup AssessmentLookup
@inject IAssessmentModerationService ModerationService
@inject IRoleMembershipQuery RoleMembershipQuery
@inject IClock Clock
@inject ISnackbar Snackbar

<PageTitle>Assessment Marks — HAMS</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Assessment Marks &amp; Moderation</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid>
        <MudItem xs="12" sm="6" md="2">
            <MudSelect T="Guid" Value="_selectedSchoolId" ValueChanged="OnSchoolChangedAsync" Label="School" Dense="true">
                <MudSelectItem T="Guid" Value="Guid.Empty">(Select a school)</MudSelectItem>
                @foreach (var school in _schools) { <MudSelectItem T="Guid" Value="@school.Id">@school.Name</MudSelectItem> }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudSelect T="Guid" Value="_selectedAcademicYearId" ValueChanged="OnAcademicYearChangedAsync" Label="Year" Dense="true" Disabled="@(_academicYears.Count == 0)">
                <MudSelectItem T="Guid" Value="Guid.Empty">(Select an academic year)</MudSelectItem>
                @foreach (var year in _academicYears) { <MudSelectItem T="Guid" Value="@year.Id">@year.Name</MudSelectItem> }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudSelect T="Guid" Value="_selectedGradeId" ValueChanged="OnGradeChangedAsync" Label="Grade" Dense="true" Disabled="@(_grades.Count == 0)">
                <MudSelectItem T="Guid" Value="Guid.Empty">(Select a grade)</MudSelectItem>
                @foreach (var grade in _grades) { <MudSelectItem T="Guid" Value="@grade.Id">@grade.Name</MudSelectItem> }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudSelect T="Guid" Value="_selectedTermId" ValueChanged="OnTermChangedAsync" Label="Term" Dense="true" Disabled="@(_terms.Count == 0)">
                <MudSelectItem T="Guid" Value="Guid.Empty">(Select a term)</MudSelectItem>
                @foreach (var term in _terms) { <MudSelectItem T="Guid" Value="@term.Id">@term.Name</MudSelectItem> }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudSelect T="Guid" Value="_selectedSubjectId" ValueChanged="OnSubjectChangedAsync" Label="Subject" Dense="true" Disabled="@(_subjects.Count == 0)">
                <MudSelectItem T="Guid" Value="Guid.Empty">(Select a subject)</MudSelectItem>
                @foreach (var subject in _subjects) { <MudSelectItem T="Guid" Value="@subject.Id">@subject.Name</MudSelectItem> }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="2">
            <MudSelect T="Guid" Value="_selectedAssessmentId" ValueChanged="OnAssessmentChangedAsync" Label="Assessment" Dense="true" Disabled="@(_assessments.Count == 0)">
                <MudSelectItem T="Guid" Value="Guid.Empty">(Select an assessment)</MudSelectItem>
                @foreach (var assessment in _assessments) { <MudSelectItem T="Guid" Value="@assessment.Id">@assessment.Title</MudSelectItem> }
            </MudSelect>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_selectedAssessmentId == Guid.Empty)
{
    <MudAlert Severity="Severity.Info">Choose a school, year, grade, term, subject and assessment to continue.</MudAlert>
}
else if (_policyId is null)
{
    <MudAlert Severity="Severity.Warning">This grade has no published key-stage policy for this academic year — marks cannot be recorded yet.</MudAlert>
}
else
{
    <MudTable Items="@_rows" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>Student</MudTh>
            <MudTh>Raw</MudTh>
            <MudTh>Adjusted</MudTh>
            <MudTh>Moderated</MudTh>
            <MudTh>Final</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Student">@context.StudentName</MudTd>
            <MudTd DataLabel="Raw">
                @if (context.ResultId is null)
                {
                    <MudNumericField T="decimal?" @bind-Value="context.NewRawMark" Margin="Margin.Dense" Style="max-width: 90px" />
                }
                else
                {
                    @(context.RawMark?.ToString() ?? "—")
                }
            </MudTd>
            <MudTd DataLabel="Adjusted">@(context.AdjustedMark?.ToString() ?? "—")</MudTd>
            <MudTd DataLabel="Moderated">@(context.ModeratedMark?.ToString() ?? "—")</MudTd>
            <MudTd DataLabel="Final">@(context.FinalMark?.ToString() ?? "—")</MudTd>
            <MudTd DataLabel="Status">
                @if (context.ResultId is not null)
                {
                    <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)">@context.Status</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Actions">
                @if (context.ResultId is null)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => RecordMarkAsync(context))">Record</MudButton>
                }
                else if (context.Status == WorkflowStatus.Draft || context.Status == WorkflowStatus.Returned)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => SubmitAsync(context))">Submit</MudButton>
                }
                else if (context.Status == WorkflowStatus.Submitted)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => BeginReviewAsync(context))">Begin Review</MudButton>
                }
                else if (context.Status == WorkflowStatus.UnderReview)
                {
                    <MudStack Row="true" Spacing="1">
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" OnClick="@(() => ApproveAsync(context))">Approve</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => RejectAsync(context))">Reject</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ReturnAsync(context))">Return</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning" OnClick="@(() => EscalateAsync(context))">Escalate</MudButton>
                    </MudStack>
                }
                else if (context.Status == WorkflowStatus.Escalated)
                {
                    <MudStack Row="true" Spacing="1">
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" Disabled="!_isAdmin" OnClick="@(() => ApproveAsync(context))">Approve</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Disabled="!_isAdmin" OnClick="@(() => RejectAsync(context))">Reject</MudButton>
                        @if (!_isAdmin)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Escalated — only an administrator can decide this.</MudText>
                        }
                    </MudStack>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private Guid? _currentPersonId;
    private bool _isAdmin;

    private IReadOnlyList<SchoolOption> _schools = [];
    private IReadOnlyList<AcademicYearOption> _academicYears = [];
    private IReadOnlyList<GradeOption> _grades = [];
    private IReadOnlyList<TermOption> _terms = [];
    private IReadOnlyList<SubjectOption> _subjects = [];
    private IReadOnlyList<AssessmentOption> _assessments = [];

    private Guid _selectedSchoolId, _selectedAcademicYearId, _selectedGradeId, _selectedTermId, _selectedSubjectId, _selectedAssessmentId;
    private Guid? _policyId;

    private List<MarkRow> _rows = [];
    private bool _loading = true;

    private sealed class MarkRow(Guid studentPersonId, string studentName)
    {
        public Guid StudentPersonId { get; } = studentPersonId;
        public string StudentName { get; } = studentName;
        public Guid? ResultId { get; set; }
        public decimal? RawMark { get; set; }
        public decimal? AdjustedMark { get; set; }
        public decimal? ModeratedMark { get; set; }
        public decimal? FinalMark { get; set; }
        public WorkflowStatus Status { get; set; }
        public decimal? NewRawMark { get; set; }
    }

    private static Color StatusColor(WorkflowStatus status) => status switch
    {
        WorkflowStatus.Approved => Color.Success,
        WorkflowStatus.Rejected => Color.Error,
        WorkflowStatus.Escalated => Color.Warning,
        WorkflowStatus.Returned => Color.Warning,
        _ => Color.Default,
    };

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            if (Guid.TryParse(user.FindFirstValue(HamsClaimTypes.PersonId), out var personId))
            {
                _currentPersonId = personId;
                _isAdmin = await RoleMembershipQuery.IsSystemOrSchoolAdminAsync(personId, Clock.TodayUtc);
            }
        }

        try
        {
            _schools = await OrgLookup.GetSchoolsAsync();
            if (_schools.Count > 0)
            {
                await OnSchoolChangedAsync(_schools[0].Id);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Could not load setup data.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSchoolChangedAsync(Guid schoolId)
    {
        _selectedSchoolId = schoolId;
        _academicYears = await OrgLookup.GetAcademicYearsAsync(schoolId);
        _grades = await OrgLookup.GetGradesAsync(schoolId);
        _subjects = await OrgLookup.GetSubjectsAsync(schoolId);
        if (_grades.Count > 0) _selectedGradeId = _grades[0].Id;
        if (_subjects.Count > 0) _selectedSubjectId = _subjects[0].Id;
        _rows = [];
        _assessments = [];

        if (_academicYears.Count > 0)
        {
            await OnAcademicYearChangedAsync(_academicYears[0].Id);
        }
    }

    private async Task OnAcademicYearChangedAsync(Guid academicYearId)
    {
        _selectedAcademicYearId = academicYearId;
        _terms = await OrgLookup.GetTermsAsync(academicYearId);
        if (_terms.Count > 0)
        {
            _selectedTermId = _terms[0].Id;
        }

        await ReloadAssessmentsAsync();
    }

    private async Task OnGradeChangedAsync(Guid gradeId)
    {
        _selectedGradeId = gradeId;
        await ReloadAssessmentsAsync();
    }

    private async Task OnTermChangedAsync(Guid termId)
    {
        _selectedTermId = termId;
        await ReloadAssessmentsAsync();
    }

    private async Task OnSubjectChangedAsync(Guid subjectId)
    {
        _selectedSubjectId = subjectId;
        await ReloadAssessmentsAsync();
    }

    private async Task ReloadAssessmentsAsync()
    {
        _rows = [];
        _selectedAssessmentId = Guid.Empty;

        if (_selectedGradeId == Guid.Empty || _selectedTermId == Guid.Empty || _selectedSubjectId == Guid.Empty)
        {
            return;
        }

        _assessments = await AssessmentLookup.GetAssessmentsAsync(_selectedSubjectId, _selectedGradeId, _selectedTermId);
        if (_assessments.Count > 0)
        {
            await OnAssessmentChangedAsync(_assessments[0].Id);
        }
    }

    private async Task OnAssessmentChangedAsync(Guid assessmentId)
    {
        _selectedAssessmentId = assessmentId;
        await LoadMarksAsync();
    }

    private async Task LoadMarksAsync()
    {
        if (_selectedAssessmentId == Guid.Empty)
        {
            return;
        }

        _loading = true;
        try
        {
            var policy = await PolicyResolver.ResolveAsync(_selectedGradeId, _selectedAcademicYearId, Clock.TodayUtc);
            _policyId = policy?.Id;

            var roster = await EnrollmentService.GetActiveRosterForGradeAsync(_selectedGradeId, _selectedAcademicYearId, Clock.TodayUtc);
            var results = await AssessmentLookup.GetResultsForAssessmentAsync(_selectedAssessmentId);
            var resultsByStudent = results.ToDictionary(r => r.StudentPersonId);

            _rows = roster.Select(r =>
            {
                var row = new MarkRow(r.StudentPersonId, r.NameEn);
                if (resultsByStudent.TryGetValue(r.StudentPersonId, out var result))
                {
                    row.ResultId = result.Id;
                    row.RawMark = result.RawMark;
                    row.AdjustedMark = result.AdjustedMark;
                    row.ModeratedMark = result.ModeratedMark;
                    row.FinalMark = result.FinalMark;
                    row.Status = result.ModerationStatus;
                }

                return row;
            }).ToList();
        }
        catch (Exception)
        {
            Snackbar.Add("Could not load marks for this assessment.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RecordMarkAsync(MarkRow row)
    {
        if (_currentPersonId is not { } recordedBy || _policyId is not { } policyId || row.NewRawMark is null)
        {
            return;
        }

        try
        {
            await ModerationService.RecordRawMarkAsync(_selectedAssessmentId, row.StudentPersonId, policyId, row.NewRawMark, null, recordedBy);
            Snackbar.Add("Mark recorded.", Severity.Success);
            await LoadMarksAsync();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task SubmitAsync(MarkRow row)
    {
        if (row.ResultId is not { } id) return;
        await RunTransitionAsync(() => ModerationService.SubmitAsync(id));
    }

    private async Task BeginReviewAsync(MarkRow row)
    {
        if (row.ResultId is not { } id) return;
        await RunTransitionAsync(() => ModerationService.BeginReviewAsync(id, null));
    }

    private async Task ApproveAsync(MarkRow row)
    {
        if (row.ResultId is not { } id) return;
        if (row.Status == WorkflowStatus.Escalated && !_isAdmin)
        {
            Snackbar.Add("Only a System/School Administrator may decide an escalated result.", Severity.Error);
            return;
        }

        await RunTransitionAsync(() => ModerationService.ApproveAsync(id, null));
    }

    private async Task RejectAsync(MarkRow row)
    {
        if (row.ResultId is not { } id) return;
        if (row.Status == WorkflowStatus.Escalated && !_isAdmin)
        {
            Snackbar.Add("Only a System/School Administrator may decide an escalated result.", Severity.Error);
            return;
        }

        await RunTransitionAsync(() => ModerationService.RejectAsync(id));
    }

    private async Task ReturnAsync(MarkRow row)
    {
        if (row.ResultId is not { } id) return;
        await RunTransitionAsync(() => ModerationService.ReturnAsync(id));
    }

    private async Task EscalateAsync(MarkRow row)
    {
        if (row.ResultId is not { } id || _currentPersonId is not { } escalatedBy) return;
        await RunTransitionAsync(() => ModerationService.EscalateAsync(id, escalatedBy, "Escalated for a senior decision from the marks-entry screen."));
    }

    private async Task RunTransitionAsync(Func<Task> action)
    {
        try
        {
            await action();
            await LoadMarksAsync();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
