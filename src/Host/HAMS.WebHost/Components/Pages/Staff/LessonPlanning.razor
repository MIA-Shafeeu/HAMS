@page "/lesson-planning"
@using HAMS.WebHost.Components.Account
@attribute [Authorize(Policy = StaffPolicy.Name)]
@rendermode InteractiveServer
@using HAMS.IdentityAccess.Application.Jwt
@using HAMS.LearningDelivery.Application
@using HAMS.LearningDelivery.Domain
@using HAMS.OrgCurriculum.Application
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject IOrgStructureLookup OrgLookup
@inject ILessonPlanningService PlanningService
@inject ISnackbar Snackbar

<PageTitle>Lesson Planning — HAMS</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Scheme of Work &amp; Lesson Planning</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="Guid" Value="_selectedSchoolId" ValueChanged="OnSchoolChangedAsync" Label="School" Dense="true">
                @foreach (var school in _schools) { <MudSelectItem T="Guid" Value="@school.Id">@school.Name</MudSelectItem> }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="Guid" Value="_selectedAcademicYearId" ValueChanged="OnAcademicYearChangedAsync" Label="Academic year" Dense="true" Disabled="@(_academicYears.Count == 0)">
                @foreach (var year in _academicYears) { <MudSelectItem T="Guid" Value="@year.Id">@year.Name</MudSelectItem> }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="Guid" Value="_selectedGradeId" ValueChanged="OnGradeChangedAsync" Label="Grade" Dense="true" Disabled="@(_grades.Count == 0)">
                @foreach (var grade in _grades) { <MudSelectItem T="Guid" Value="@grade.Id">@grade.Name</MudSelectItem> }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="Guid" ValueChanged="OnSubjectChangedAsync" Value="_selectedSubjectId" Label="Subject" Dense="true" Disabled="@(_subjects.Count == 0)">
                @foreach (var subject in _subjects) { <MudSelectItem T="Guid" Value="@subject.Id">@subject.Name</MudSelectItem> }
            </MudSelect>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_selectedSubjectId != Guid.Empty)
{
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.h6" Class="mb-2">Schemes of Work</MudText>
        @if (_schemes.Count > 0)
        {
            <MudTable Items="@_schemes" Dense="true" Hover="true" Class="mb-3">
                <HeaderContent><MudTh>Title</MudTh><MudTh></MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Title">@context.Title</MudTd>
                    <MudTd><MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => SelectSchemeAsync(context.Id))">Open</MudButton></MudTd>
                </RowTemplate>
            </MudTable>
        }
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End">
            <MudTextField T="string" @bind-Value="_newSchemeTitle" Label="New scheme title" Style="max-width: 300px" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateSchemeAsync">Create Scheme</MudButton>
        </MudStack>
    </MudPaper>
}

@if (_selectedSchemeId is not null)
{
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.h6" Class="mb-2">Curriculum Items in this Scheme</MudText>
        @if (_items.Count > 0)
        {
            <MudTable Items="@_items" Dense="true" Hover="true" Class="mb-3">
                <HeaderContent><MudTh>Learning Outcome Id</MudTh><MudTh>Week</MudTh><MudTh></MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Learning Outcome Id">@context.LearningOutcomeId</MudTd>
                    <MudTd DataLabel="Week">@context.PlannedWeekNumber</MudTd>
                    <MudTd><MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => SelectItemAsync(context.Id))">Open</MudButton></MudTd>
                </RowTemplate>
            </MudTable>
        }
        <MudGrid>
            <MudItem xs="12" sm="4"><MudTextField T="string" @bind-Value="_newItemOutcomeId" Label="Learning outcome id (GUID)" /></MudItem>
            <MudItem xs="12" sm="3"><MudNumericField T="int" @bind-Value="_newItemWeek" Label="Planned week #" /></MudItem>
            <MudItem xs="12" sm="3"><MudNumericField T="int" @bind-Value="_newItemDisplayOrder" Label="Display order" /></MudItem>
            <MudItem xs="12" sm="2" Class="d-flex align-end"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddItemAsync">Add Item</MudButton></MudItem>
        </MudGrid>
    </MudPaper>
}

@if (_selectedItemId is not null)
{
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudText Typo="Typo.h6" Class="mb-2">Teaching Topics</MudText>
        @if (_topics.Count > 0)
        {
            <MudTable Items="@_topics" Dense="true" Hover="true" Class="mb-3">
                <HeaderContent><MudTh>Name</MudTh><MudTh></MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">@context.NameEn</MudTd>
                    <MudTd><MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => SelectTopicAsync(context.Id))">Open</MudButton></MudTd>
                </RowTemplate>
            </MudTable>
        }
        <MudGrid>
            <MudItem xs="12" sm="4"><MudTextField T="string" @bind-Value="_newTopicNameEn" Label="Topic name (English)" /></MudItem>
            <MudItem xs="12" sm="4"><MudTextField T="string" @bind-Value="_newTopicNameDv" Label="Topic name (Dhivehi)" /></MudItem>
            <MudItem xs="12" sm="2"><MudNumericField T="int" @bind-Value="_newTopicDisplayOrder" Label="Display order" /></MudItem>
            <MudItem xs="12" sm="2" Class="d-flex align-end"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateTopicAsync">Add Topic</MudButton></MudItem>
        </MudGrid>
    </MudPaper>
}

@if (_selectedTopicId is { } topicId)
{
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-2">Lesson Plans</MudText>
                @if (_lessonPlans.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">No lesson plans yet for this topic.</MudText>
                }
                else
                {
                    <MudTable Items="@_lessonPlans" Dense="true" Hover="true" Class="mb-3">
                        <HeaderContent><MudTh>Date</MudTh><MudTh>Objectives</MudTh></HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Date">@context.PlannedDate.ToString("yyyy-MM-dd")</MudTd>
                            <MudTd DataLabel="Objectives">@context.Objectives</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                <MudDatePicker Label="Planned date" Date="_newPlanDate" DateChanged="d => _newPlanDate = d" Class="mb-2" />
                <MudTextField T="string" @bind-Value="_newPlanObjectives" Label="Objectives" Lines="3" Class="mb-2" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => CreateLessonPlanAsync(topicId))">Add Lesson Plan</MudButton>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-2">Resources</MudText>
                @if (_resources.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">No resources attached yet.</MudText>
                }
                else
                {
                    <MudTable Items="@_resources" Dense="true" Hover="true" Class="mb-3">
                        <HeaderContent><MudTh>Title</MudTh><MudTh>Link</MudTh></HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Title">@context.TitleEn</MudTd>
                            <MudTd DataLabel="Link"><MudLink Href="@context.FileReference" Target="_blank">@context.FileReference</MudLink></MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                <MudGrid Class="mb-2">
                    <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="_newResourceTitleEn" Label="Title (English)" /></MudItem>
                    <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="_newResourceTitleDv" Label="Title (Dhivehi)" /></MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" @bind-Value="_newResourceTypeCode" Label="Resource type" Dense="true">
                            @foreach (var type in _resourceTypes) { <MudSelectItem T="string" Value="@type.Code">@type.Name</MudSelectItem> }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6"><MudTextField T="string" @bind-Value="_newResourceFileReference" Label="Link or file path" /></MudItem>
                </MudGrid>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => AddResourceAsync(topicId))">Add Resource</MudButton>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private Guid? _currentPersonId;

    private IReadOnlyList<SchoolOption> _schools = [];
    private IReadOnlyList<AcademicYearOption> _academicYears = [];
    private IReadOnlyList<GradeOption> _grades = [];
    private IReadOnlyList<SubjectOption> _subjects = [];
    private IReadOnlyList<ResourceType> _resourceTypes = [];

    private Guid _selectedSchoolId, _selectedAcademicYearId, _selectedGradeId, _selectedSubjectId;
    private string _newSchemeTitle = "";

    private List<SchemeOfWork> _schemes = [];
    private Guid? _selectedSchemeId;

    private List<SchemeOfWorkItem> _items = [];
    private Guid? _selectedItemId;
    private string _newItemOutcomeId = "";
    private int _newItemWeek = 1;
    private int _newItemDisplayOrder = 1;

    private List<TeachingTopic> _topics = [];
    private Guid? _selectedTopicId;
    private string _newTopicNameEn = "";
    private string _newTopicNameDv = "";
    private int _newTopicDisplayOrder = 1;

    private List<LessonPlan> _lessonPlans = [];
    private DateTime? _newPlanDate = DateTime.Today;
    private string _newPlanObjectives = "";

    private List<Resource> _resources = [];
    private string _newResourceTitleEn = "";
    private string _newResourceTitleDv = "";
    private string _newResourceTypeCode = "";
    private string _newResourceFileReference = "";

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            if (Guid.TryParse(user.FindFirstValue(HamsClaimTypes.PersonId), out var personId))
            {
                _currentPersonId = personId;
            }
        }

        try
        {
            _schools = await OrgLookup.GetSchoolsAsync();
            _resourceTypes = await PlanningService.GetResourceTypesAsync();
            if (_resourceTypes.Count > 0)
            {
                _newResourceTypeCode = _resourceTypes[0].Code;
            }

            if (_schools.Count > 0)
            {
                await OnSchoolChangedAsync(_schools[0].Id);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Could not load setup data.", Severity.Error);
        }
    }

    private async Task OnSchoolChangedAsync(Guid schoolId)
    {
        _selectedSchoolId = schoolId;
        _academicYears = await OrgLookup.GetAcademicYearsAsync(schoolId);
        _grades = await OrgLookup.GetGradesAsync(schoolId);
        _subjects = await OrgLookup.GetSubjectsAsync(schoolId);
        if (_grades.Count > 0) _selectedGradeId = _grades[0].Id;

        ResetBelowScheme();

        if (_academicYears.Count > 0)
        {
            await OnAcademicYearChangedAsync(_academicYears[0].Id);
        }
        else if (_subjects.Count > 0)
        {
            await OnSubjectChangedAsync(_subjects[0].Id);
        }
    }

    private async Task OnAcademicYearChangedAsync(Guid academicYearId)
    {
        _selectedAcademicYearId = academicYearId;
        if (_subjects.Count > 0)
        {
            await OnSubjectChangedAsync(_subjects[0].Id);
        }
    }

    private async Task OnGradeChangedAsync(Guid gradeId)
    {
        _selectedGradeId = gradeId;
        ResetBelowScheme();

        if (_selectedSubjectId == Guid.Empty || _selectedAcademicYearId == Guid.Empty)
        {
            return;
        }

        _schemes = (await PlanningService.GetSchemesOfWorkAsync(_selectedSubjectId, _selectedGradeId, _selectedAcademicYearId)).ToList();
    }

    private async Task OnSubjectChangedAsync(Guid subjectId)
    {
        _selectedSubjectId = subjectId;
        ResetBelowScheme();

        if (_selectedGradeId == Guid.Empty || _selectedAcademicYearId == Guid.Empty)
        {
            return;
        }

        _schemes = (await PlanningService.GetSchemesOfWorkAsync(subjectId, _selectedGradeId, _selectedAcademicYearId)).ToList();
    }

    private void ResetBelowScheme()
    {
        _schemes = [];
        _selectedSchemeId = null;
        _items = [];
        _selectedItemId = null;
        _topics = [];
        _selectedTopicId = null;
        _lessonPlans = [];
        _resources = [];
    }

    private async Task CreateSchemeAsync()
    {
        if (string.IsNullOrWhiteSpace(_newSchemeTitle) || _selectedGradeId == Guid.Empty || _selectedAcademicYearId == Guid.Empty)
        {
            Snackbar.Add("Select a grade and academic year, and enter a title.", Severity.Warning);
            return;
        }

        await PlanningService.CreateSchemeOfWorkAsync(_selectedSubjectId, _selectedGradeId, _selectedAcademicYearId, _newSchemeTitle);
        _newSchemeTitle = "";
        Snackbar.Add("Scheme of work created.", Severity.Success);
        _schemes = (await PlanningService.GetSchemesOfWorkAsync(_selectedSubjectId, _selectedGradeId, _selectedAcademicYearId)).ToList();
    }

    private async Task SelectSchemeAsync(Guid schemeId)
    {
        _selectedSchemeId = schemeId;
        _items = (await PlanningService.GetSchemeOfWorkItemsAsync(schemeId)).ToList();
        _selectedItemId = null;
        _topics = [];
        _selectedTopicId = null;
        _lessonPlans = [];
        _resources = [];
    }

    private async Task AddItemAsync()
    {
        if (_selectedSchemeId is not { } schemeId || !Guid.TryParse(_newItemOutcomeId, out var outcomeId))
        {
            Snackbar.Add("Enter a valid learning outcome id.", Severity.Warning);
            return;
        }

        await PlanningService.AddSchemeOfWorkItemAsync(schemeId, outcomeId, _newItemWeek, _newItemDisplayOrder);
        _newItemOutcomeId = "";
        Snackbar.Add("Item added.", Severity.Success);
        _items = (await PlanningService.GetSchemeOfWorkItemsAsync(schemeId)).ToList();
    }

    private async Task SelectItemAsync(Guid itemId)
    {
        _selectedItemId = itemId;
        _topics = (await PlanningService.GetTeachingTopicsAsync(itemId)).ToList();
        _selectedTopicId = null;
        _lessonPlans = [];
        _resources = [];
    }

    private async Task CreateTopicAsync()
    {
        if (_selectedItemId is not { } itemId || string.IsNullOrWhiteSpace(_newTopicNameEn) || string.IsNullOrWhiteSpace(_newTopicNameDv))
        {
            Snackbar.Add("Enter both the English and Dhivehi topic name.", Severity.Warning);
            return;
        }

        await PlanningService.CreateTeachingTopicAsync(itemId, _newTopicNameEn, _newTopicNameDv, _newTopicDisplayOrder);
        _newTopicNameEn = "";
        _newTopicNameDv = "";
        Snackbar.Add("Teaching topic added.", Severity.Success);
        _topics = (await PlanningService.GetTeachingTopicsAsync(itemId)).ToList();
    }

    private async Task SelectTopicAsync(Guid topicId)
    {
        _selectedTopicId = topicId;
        _lessonPlans = (await PlanningService.GetLessonPlansAsync(topicId)).ToList();
        _resources = (await PlanningService.GetResourcesAsync(topicId)).ToList();
    }

    private async Task CreateLessonPlanAsync(Guid topicId)
    {
        if (_currentPersonId is not { } staffId || _newPlanDate is not { } plannedDate || string.IsNullOrWhiteSpace(_newPlanObjectives))
        {
            Snackbar.Add("Set a planned date and enter objectives.", Severity.Warning);
            return;
        }

        await PlanningService.CreateLessonPlanAsync(topicId, staffId, DateOnly.FromDateTime(plannedDate), _newPlanObjectives);
        _newPlanObjectives = "";
        Snackbar.Add("Lesson plan added.", Severity.Success);
        _lessonPlans = (await PlanningService.GetLessonPlansAsync(topicId)).ToList();
    }

    private async Task AddResourceAsync(Guid topicId)
    {
        if (_currentPersonId is not { } uploaderId || string.IsNullOrWhiteSpace(_newResourceTitleEn)
            || string.IsNullOrWhiteSpace(_newResourceFileReference) || string.IsNullOrWhiteSpace(_newResourceTypeCode))
        {
            return;
        }

        try
        {
            await PlanningService.AddResourceAsync(topicId, _newResourceTitleEn, _newResourceTitleDv, _newResourceTypeCode, _newResourceFileReference, uploaderId);
            _newResourceTitleEn = "";
            _newResourceTitleDv = "";
            _newResourceFileReference = "";
            Snackbar.Add("Resource added.", Severity.Success);
            _resources = (await PlanningService.GetResourcesAsync(topicId)).ToList();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
