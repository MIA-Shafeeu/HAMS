@page "/attendance"
@using HAMS.WebHost.Components.Account
@attribute [Authorize(Policy = StaffPolicy.Name)]
@rendermode InteractiveServer
@using HAMS.Attendance.Application
@using HAMS.IdentityAccess.Application.Jwt
@using HAMS.OrgCurriculum.Application
@using HAMS.PeopleEnrollment.Application
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject IOrgStructureLookup OrgLookup
@inject IStudentEnrollmentService EnrollmentService
@inject IAttendanceQueryService AttendanceQuery
@inject IAttendanceService AttendanceService
@inject ISnackbar Snackbar

<PageTitle>Attendance — HAMS</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Daily Attendance</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="Guid" Value="_selectedSchoolId" ValueChanged="OnSchoolChangedAsync" Label="School" Dense="true">
                @foreach (var school in _schools)
                {
                    <MudSelectItem T="Guid" Value="@school.Id">@school.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="Guid" Value="_selectedAcademicYearId" ValueChanged="OnAcademicYearChangedAsync" Label="Academic year" Dense="true" Disabled="@(_academicYears.Count == 0)">
                @foreach (var year in _academicYears)
                {
                    <MudSelectItem T="Guid" Value="@year.Id">@year.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="Guid" Value="_selectedClassId" ValueChanged="OnClassChangedAsync" Label="Class" Dense="true" Disabled="@(_classes.Count == 0)">
                @foreach (var classOption in _classes)
                {
                    <MudSelectItem T="Guid" Value="@classOption.Id">@classOption.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudDatePicker Label="Date" Date="_selectedDate" DateChanged="OnDateChangedAsync" Editable="true" DateFormat="yyyy-MM-dd" />
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (_selectedClassId == Guid.Empty)
{
    <MudAlert Severity="Severity.Info">Choose a school, academic year and class to load the roster.</MudAlert>
}
else if (_roster.Count == 0)
{
    <MudAlert Severity="Severity.Info">No students are currently enrolled in this class.</MudAlert>
}
else
{
    <MudTable Items="@_roster" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>Admission No</MudTh>
            <MudTh>Student</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Notes</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Admission No">@context.AdmissionNumber</MudTd>
            <MudTd DataLabel="Student">@context.NameEn</MudTd>
            <MudTd DataLabel="Status">
                <MudSelect T="string" @bind-Value="context.StatusCode" Dense="true" Margin="Margin.Dense">
                    @foreach (var status in _statuses)
                    {
                        <MudSelectItem T="string" Value="@status.Code">@status.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudTd>
            <MudTd DataLabel="Notes">
                <MudTextField T="string" @bind-Value="context.Notes" Margin="Margin.Dense" Placeholder="Optional" />
            </MudTd>
        </RowTemplate>
    </MudTable>

    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" OnClick="SaveAttendanceAsync" Disabled="_saving">
        Save Attendance
    </MudButton>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private Guid? _recordedByPersonId;

    private IReadOnlyList<SchoolOption> _schools = [];
    private IReadOnlyList<AcademicYearOption> _academicYears = [];
    private IReadOnlyList<ClassOption> _classes = [];
    private IReadOnlyList<AttendanceStatusOption> _statuses = [];

    private Guid _selectedSchoolId;
    private Guid _selectedAcademicYearId;
    private Guid _selectedClassId;
    private DateTime? _selectedDate = DateTime.Today;

    private List<RosterRow> _roster = [];
    private bool _loading = true;
    private bool _saving;

    private sealed class RosterRow(Guid studentPersonId, string nameEn, string nameDv, string admissionNumber, string statusCode)
    {
        public Guid StudentPersonId { get; } = studentPersonId;
        public string NameEn { get; } = nameEn;
        public string NameDv { get; } = nameDv;
        public string AdmissionNumber { get; } = admissionNumber;
        public string StatusCode { get; set; } = statusCode;
        public string? Notes { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var user = (await AuthState).User;
            if (Guid.TryParse(user.FindFirstValue(HamsClaimTypes.PersonId), out var personId))
            {
                _recordedByPersonId = personId;
            }
        }

        try
        {
            _schools = await OrgLookup.GetSchoolsAsync();
            _statuses = await AttendanceQuery.GetStatusesAsync();
            if (_schools.Count > 0)
            {
                await OnSchoolChangedAsync(_schools[0].Id);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Could not load attendance setup data.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSchoolChangedAsync(Guid schoolId)
    {
        _selectedSchoolId = schoolId;
        _selectedAcademicYearId = Guid.Empty;
        _selectedClassId = Guid.Empty;
        _roster = [];
        _classes = [];

        _academicYears = await OrgLookup.GetAcademicYearsAsync(schoolId);
        if (_academicYears.Count > 0)
        {
            await OnAcademicYearChangedAsync(_academicYears[0].Id);
        }
    }

    private async Task OnAcademicYearChangedAsync(Guid academicYearId)
    {
        _selectedAcademicYearId = academicYearId;
        _selectedClassId = Guid.Empty;
        _roster = [];

        _classes = await OrgLookup.GetClassesAsync(academicYearId);
        if (_classes.Count > 0)
        {
            await OnClassChangedAsync(_classes[0].Id);
        }
    }

    private async Task OnClassChangedAsync(Guid classId)
    {
        _selectedClassId = classId;
        await LoadRosterAsync();
    }

    private async Task LoadRosterAsync()
    {
        if (_selectedClassId == Guid.Empty || _selectedDate is not { } selectedDate)
        {
            return;
        }

        _loading = true;
        try
        {
            var date = DateOnly.FromDateTime(selectedDate);
            var roster = await EnrollmentService.GetActiveRosterForClassAsync(_selectedClassId, date);
            var existing = await AttendanceQuery.GetDailyRecordsForStudentsAsync(roster.Select(r => r.StudentPersonId).ToList(), date);
            var existingByStudent = existing.ToDictionary(e => e.StudentPersonId, e => e.AttendanceStatusCode);
            var defaultStatus = _statuses.FirstOrDefault(s => s.Code == "PRESENT")?.Code ?? _statuses.FirstOrDefault()?.Code ?? "";

            _roster = roster
                .Select(r => new RosterRow(r.StudentPersonId, r.NameEn, r.NameDv, r.AdmissionNumber,
                    existingByStudent.TryGetValue(r.StudentPersonId, out var code) ? code : defaultStatus))
                .ToList();
        }
        catch (Exception)
        {
            Snackbar.Add("Could not load the class roster.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAttendanceAsync()
    {
        if (_recordedByPersonId is not { } recordedBy || _selectedDate is not { } selectedDate)
        {
            return;
        }

        _saving = true;
        var date = DateOnly.FromDateTime(selectedDate);
        var failureCount = 0;

        foreach (var row in _roster)
        {
            try
            {
                await AttendanceService.MarkDailyAttendanceAsync(
                    _selectedSchoolId, row.StudentPersonId, date, _selectedAcademicYearId, row.StatusCode, recordedBy, row.Notes);
            }
            catch (InvalidOperationException)
            {
                failureCount++;
            }
        }

        _saving = false;

        if (failureCount > 0)
        {
            Snackbar.Add($"{date:yyyy-MM-dd} isn't a school day — no attendance was recorded.", Severity.Warning);
        }
        else
        {
            Snackbar.Add("Attendance saved.", Severity.Success);
        }
    }

    private async Task OnDateChangedAsync(DateTime? date)
    {
        _selectedDate = date;
        await LoadRosterAsync();
    }
}
