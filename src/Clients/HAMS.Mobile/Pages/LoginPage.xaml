<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="HAMS.Mobile.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Sign In"
    Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">

            <Label Text="HAMS" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="Hirilandhoo Academic Management System" FontSize="14" HorizontalOptions="Center" Margin="0,0,0,24" />

            <Entry x:Name="UsernameEntry" Placeholder="Username or email" Keyboard="Email" />
            <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True" />

            <Button x:Name="SignInButton" Text="Sign In" Clicked="OnSignInClicked" Margin="0,16,0,0" />

            <ActivityIndicator x:Name="BusyIndicator" IsRunning="False" IsVisible="False" />

            <Label x:Name="ErrorLabel" TextColor="Red" IsVisible="False" HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
