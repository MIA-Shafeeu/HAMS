<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="HAMS.Mobile.Pages.TimetablePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:HAMS.Mobile.Models"
    Title="My Timetable">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Sign Out" Clicked="OnSignOutClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">

        <ActivityIndicator x:Name="BusyIndicator" Grid.Row="0" IsRunning="False" IsVisible="False" />

        <RefreshView x:Name="TimetableRefreshView" Grid.Row="1" Refreshing="OnRefreshing">
            <CollectionView x:Name="TimetableList">
                <CollectionView.EmptyView>
                    <Label Text="No teaching timetable entries found for this academic year." Padding="16" HorizontalTextAlignment="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:StaffTimetableEntry">
                        <Grid Padding="12" ColumnDefinitions="80,*">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEntryTapped" CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout Grid.Column="0">
                                <Label Text="{Binding DayOfWeek}" FontAttributes="Bold" />
                                <Label Text="{Binding PeriodStartTime}" FontSize="12" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="{Binding SubjectName}" FontAttributes="Bold" />
                                <Label Text="{Binding ClassName}" FontSize="14" />
                                <Label Text="{Binding PeriodName}" FontSize="12" />
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
